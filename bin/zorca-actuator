#!/usr/bin/env python3
"""
zorca-actuator - the Mac-side half of ZOE v2 lane control.

Stage 1 of docs/DESIGN-bridge.md section 12. Telegram webhook lands on the
VPS, the VPS appends a /lane request to a queue file, and this process -
the only piece that can touch Orca, because the orca CLI is a shim into a
macOS .app - drains that queue and opens the lane.

Direction is config, not code. The Mac dialling out (mode "ssh") needs zero
inbound ports and works with Tailscale down and Remote Login off; mode
"local" is for a queue file pushed onto this box by some other means. There
is no default: an unset direction is a hard error, not a guess.

Usage:
  zorca-actuator --once            drain the queue once, then exit
  zorca-actuator --watch           drain forever at poll_seconds
  zorca-actuator --dry-run ...     print every orca call, execute none
  zorca-actuator --check           preflight only: config, port, orca, queue

Config, ~/.zao/zorca-actuator.json - every key below is REQUIRED and has no
default. Missing keys are listed all at once and the process exits 2:

  {
    "gui_port": 7777,
    "run_id": "run_xxxxxxxxxxxx",
    "poll_seconds": 10,
    "queue": {"mode": "ssh", "host": "user@vps", "path": "/srv/zorca/lane.jsonl"}
  }

Safety: opening a lane spends money, so a request is executed exactly once
(state file, keyed by request id), never past its TTL, and a lane is only
reported done after its pane has been read back and confirmed briefed.
"""
import json
import os
import re
import subprocess
import sys
import time

# Overridable only so the chain can be exercised against a stub in tests;
# production never sets it.
ORCA = os.environ.get("ZORCA_ORCA_BIN", "/opt/homebrew/bin/orca")
ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
CONFIG = os.path.expanduser("~/.zao/zorca-actuator.json")
STATE = os.path.expanduser("~/.zao/zorca-actuator-state.json")
LOG = os.path.expanduser("~/.zao/zorca-actuator.log")

DRY = False


def logline(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    stamp = time.strftime("%H:%M:%S")
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (stamp, msg))
    print("%s %s" % (stamp, msg), flush=True)


def die(msg, code=2):
    print("zorca-actuator: %s" % msg, file=sys.stderr)
    sys.exit(code)


# ---- config: no defaults, fail loudly and all at once -----------------------

def config():
    if not os.path.exists(CONFIG):
        die("no config at %s\n"
            "  Every key is required and none has a default. Write:\n"
            '  {"gui_port": 7777, "run_id": "run_...", "poll_seconds": 10,\n'
            '   "queue": {"mode": "ssh", "host": "user@vps", "path": "/srv/zorca/lane.jsonl"}}'
            % CONFIG)
    try:
        cfg = json.load(open(CONFIG))
    except Exception as e:
        die("config at %s is not valid JSON: %s" % (CONFIG, e))

    missing = []
    for key in ("gui_port", "run_id", "poll_seconds", "queue"):
        if cfg.get(key) in (None, ""):
            missing.append(key)
    q = cfg.get("queue") or {}
    if isinstance(q, dict):
        for key in ("mode", "path"):
            if not q.get(key):
                missing.append("queue.%s" % key)
        if q.get("mode") == "ssh" and not q.get("host"):
            missing.append("queue.host (required when queue.mode is ssh)")
        if q.get("mode") not in (None, "ssh", "local"):
            die('queue.mode must be "ssh" or "local", got %r' % q.get("mode"))
    else:
        missing.append("queue (must be an object)")
    if missing:
        die("config %s is missing required keys, all of which must be set "
            "explicitly:\n  - %s" % (CONFIG, "\n  - ".join(missing)))
    return cfg


# ---- preflight: the port is config, and unreachable is fatal ----------------

def gui_ok(port):
    """The GUI is the only write path. A port that answers nothing is fatal -
    zorca-gui2 runs on 7778 beside 7777, so guessing is not available."""
    import urllib.request
    try:
        with urllib.request.urlopen(
                "http://127.0.0.1:%d/api/state" % port, timeout=5) as r:
            return r.status == 200
    except Exception:
        return False


def preflight(cfg):
    problems = []
    if not os.path.exists(ORCA):
        problems.append("orca CLI not found at %s" % ORCA)
    port = cfg["gui_port"]
    if not gui_ok(port):
        problems.append(
            "ZORCA GUI on 127.0.0.1:%d did not answer /api/state. "
            "The port comes from config and is never guessed; start the GUI "
            "or correct gui_port." % port)
    ok, detail = queue_reachable(cfg["queue"])
    if not ok:
        problems.append("queue unreachable: %s" % detail)
    if problems:
        die("preflight failed:\n  - %s" % "\n  - ".join(problems))
    return True


# ---- the queue -------------------------------------------------------------

def sh(argv, timeout=30, stdin=None):
    try:
        p = subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, input=stdin)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)


def ssh_argv(q, remote_cmd):
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
            q["host"], remote_cmd]


def queue_reachable(q):
    if q["mode"] == "local":
        d = os.path.dirname(q["path"]) or "."
        if not os.path.isdir(d):
            return False, "directory %s does not exist" % d
        return True, ""
    rc, out, err = sh(ssh_argv(q, "test -f %s || test -d $(dirname %s)"
                               % (q["path"], q["path"])))
    return (rc == 0), (err.strip() or "ssh exit %d" % rc)


def queue_read(q):
    """Whole-file read of an append-only JSONL log. Malformed lines are
    logged and skipped, never fatal - one bad append must not wedge the lane."""
    if q["mode"] == "local":
        if not os.path.exists(q["path"]):
            return []
        raw = open(q["path"], errors="replace").read()
    else:
        rc, raw, err = sh(ssh_argv(q, "cat %s 2>/dev/null || true" % q["path"]),
                          timeout=60)
        if rc != 0:
            logline("QUEUE-READ-FAILED %s" % (err.strip() or rc))
            return []
    out = []
    for n, line in enumerate(raw.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except Exception:
            logline("QUEUE-BAD-LINE %d skipped" % n)
    return out


def queue_append(q, record):
    """Results are appended, never written in place: two writers and one
    reader on an append-only file are safe; a rewrite loses requests."""
    line = json.dumps(record, separators=(",", ":"))
    if DRY:
        logline("DRY append -> %s" % line)
        return True
    if q["mode"] == "local":
        with open(q["path"], "a") as f:
            f.write(line + "\n")
        return True
    rc, _, err = sh(ssh_argv(q, "cat >> %s" % q["path"]), stdin=line + "\n")
    if rc != 0:
        logline("QUEUE-APPEND-FAILED %s" % (err.strip() or rc))
    return rc == 0


# ---- state + the reaper ----------------------------------------------------

def state_read():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}


def state_write(st):
    if DRY:
        return
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    json.dump(st, open(tmp, "w"), indent=1)
    os.replace(tmp, STATE)


def reap(cfg, st):
    """Anything left `claimed` from a previous process is work that died
    mid-flight. Report it as an error so it cannot sit invisible forever -
    the farscout failure shape, closed at build time rather than after."""
    n = 0
    for rid, rec in list(st.items()):
        if rec.get("status") != "claimed":
            continue
        logline("REAPED %s (claimed at %s, no result)" % (rid, rec.get("ts")))
        queue_append(cfg["queue"], dict(
            type="result", id=rid, status="error", ts=stamp(),
            error="actuator restarted while this request was in flight; "
                  "no lane was confirmed. Re-send if still wanted."))
        rec["status"] = "reaped"
        n += 1
    if n:
        state_write(st)
    return n


# ---- orca ------------------------------------------------------------------

def stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def orca(*args, timeout=120):
    argv = [ORCA] + list(args)
    if DRY:
        logline("DRY orca %s" % " ".join(args))
        return 0, "", ""
    return sh(argv, timeout=timeout)


def run_use(run_id):
    """Unconditional, every cycle. Terminal bindings die on every Orca
    restart - measured three times in one session - so this is discovery,
    never error recovery."""
    rc, out, err = orca("orchestration", "run-use", "--id", run_id)
    return rc == 0


def screen(handle):
    rc, out, err = orca("terminal", "read", "--terminal", handle, "--screen")
    return ANSI.sub("", out or "")


def expired(rec):
    exp = rec.get("expiresAt")
    if not exp:
        return True, "no expiresAt; a request with no TTL is refused"
    if exp <= stamp():
        return True, "expired at %s (now %s)" % (exp, stamp())
    return False, ""


# ---- the /lane chain -------------------------------------------------------

def open_lane(cfg, rec):
    """Section 4 of the design, in order. Every step's hazard is one this
    estate actually hit; none of them is optional."""
    run_id = cfg["run_id"]
    request = (rec.get("request") or "").strip()
    if not request:
        return None, "empty request"

    # 1. run-use FIRST, always.
    if not run_use(run_id):
        return None, "run-use failed for %s" % run_id

    # 2. worktree + pane, titled by task (playbook rule 1).
    repo = rec.get("repo") or ""
    title = ("%s - %s" % (repo, request))[:80] if repo else request[:80]
    wt = rec.get("worktree") or ""
    create = ["terminal", "create", "--title", title, "--command", "claude"]
    if wt:
        create += ["--worktree", "path:" + wt]
    rc, out, err = orca(*create)
    handle = ""
    m = re.search(r"(term_[A-Za-z0-9-]+)", out or "")
    if m:
        handle = m.group(1)
    if DRY:
        handle = "term_DRYRUN"
    if not handle:
        return None, "no terminal handle in create output: %s" % (
            (err or out or "").strip()[:200])

    # 3. task.
    rc, out, err = orca("orchestration", "task-create", "--run", run_id,
                        "--title", title, "--spec", request)
    tid = ""
    m = re.search(r"(task_[A-Za-z0-9]+)", out or "")
    if m:
        tid = m.group(1)
    if DRY:
        tid = "task_DRYRUN"
    if not tid:
        return handle, "task-create returned no task id: %s" % (
            (err or out or "").strip()[:200])

    # 4. dispatch WITH --inject. Always. Omitting it creates the record,
    #    binds the terminal, marks the task dispatched - and briefs nobody,
    #    and it is NOT repairable: a second dispatch fails "only ready tasks
    #    can be dispatched".
    rc, out, err = orca("orchestration", "dispatch", "--task", tid,
                        "--terminal", handle, "--inject")
    if rc != 0 and not DRY:
        return handle, "dispatch --inject failed: %s" % (err or out).strip()[:200]

    # 5. brief: short, and the load-bearing line LAST. terminal send loses
    #    the HEAD of a long message, not the tail.
    brief = (
        "Lane: %s\n"
        "Full protocol: orca orchestration dispatch-show --task %s --preamble\n"
        "Read that before acting; do not infer the protocol.\n"
        "Run `orca orchestration run-use --id %s` before any orchestration "
        "command - bindings die on restart.\n"
        "Your task id is %s. Report worker_done when committed."
        % (request, tid, run_id, tid))
    orca("terminal", "send", "--terminal", handle, "--text", brief, "--enter")

    # 6. READBACK. A dispatch record is a coordinator-side fact, not evidence
    #    a worker was told anything.
    if DRY:
        logline("DRY readback skipped for %s" % handle)
        return dict(task=tid, handle=handle, title=title), ""
    time.sleep(3)
    text = screen(handle)
    if tid not in text:
        return dict(task=tid, handle=handle, title=title), (
            "brief not confirmed in pane %s: the task id is not on screen, so "
            "the send may have been truncated. Lane may be sitting at an "
            "empty prompt - do not treat as briefed." % handle)
    return dict(task=tid, handle=handle, title=title), ""


# ---- drain -----------------------------------------------------------------

def drain(cfg):
    q, st = cfg["queue"], state_read()
    records = queue_read(q)
    # Exactly-once must not rest on a single local file. The queue itself
    # carries a result record per handled request, so a lost or clobbered
    # state file cannot respawn a paid pane for work already done. State is
    # a cache; the append-only queue is the durable evidence.
    handled = {r.get("id") for r in records if r.get("type") == "result"}
    done = 0
    for rec in records:
        if rec.get("type") != "lane":
            continue
        rid = rec.get("id")
        if not rid or rid in st or rid in handled:
            continue

        gone, why = expired(rec)
        if gone:
            logline("EXPIRED %s - %s" % (rid, why))
            st[rid] = dict(status="expired", ts=stamp())
            state_write(st)
            queue_append(q, dict(type="result", id=rid, status="expired",
                                 ts=stamp(), error=why))
            continue

        # Claim before acting, so a crash mid-lane is visible to the reaper
        # rather than silently retried into a second paid pane.
        st[rid] = dict(status="claimed", ts=stamp())
        state_write(st)
        logline("CLAIMED %s %s" % (rid, (rec.get("request") or "")[:60]))

        result, err = open_lane(cfg, rec)
        if err:
            logline("ERROR %s - %s" % (rid, err))
            st[rid] = dict(status="error", ts=stamp(), error=err)
            queue_append(q, dict(type="result", id=rid, status="error",
                                 ts=stamp(), error=err,
                                 **(result or {})))
        else:
            logline("DONE %s -> %s %s" % (rid, result["task"], result["handle"]))
            st[rid] = dict(status="done", ts=stamp(), **result)
            queue_append(q, dict(type="result", id=rid, status="done",
                                 ts=stamp(), **result))
            done += 1
        state_write(st)
    return done


def main():
    global DRY
    argv = sys.argv[1:]
    DRY = "--dry-run" in argv
    cfg = config()

    if "--check" in argv:
        preflight(cfg)
        print("preflight ok: gui_port=%s run_id=%s queue=%s"
              % (cfg["gui_port"], cfg["run_id"], cfg["queue"]["mode"]))
        return

    preflight(cfg)
    st = state_read()
    n = reap(cfg, st)
    if n:
        logline("reaper: %d in-flight request(s) closed as error" % n)

    if "--watch" in argv:
        every = int(cfg["poll_seconds"])
        logline("watching queue every %ds%s" % (every, " (DRY RUN)" if DRY else ""))
        while True:
            try:
                drain(cfg)
            except Exception as e:
                logline("DRAIN-FAILED %s" % e)
            time.sleep(every)
    else:
        drain(cfg)


if __name__ == "__main__":
    main()
