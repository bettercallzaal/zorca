#!/usr/bin/env python3
"""
orca-board - ranked view of every live Orca pane, and what each one wants.

Layer 1 of the orchestrator: watch the panes, rank them, tell you which to
answer first. Layer 2 (--draft) reads each blocked pane and asks a Claude
subprocess for a proposed reply.

Usage:
  orca-board                 one-shot ranked board
  orca-board --watch [SECS]  poll forever (default 60s), print only on change
  orca-board --jump          board, then focus the top-ranked pane
  orca-board --json          machine-readable, for an agent to consume

Ranking, highest first:
  1. ctx >= 85%      about to compact, loses state if not answered
  2. asked-question  pane ended on a question mark
  3. waiting         pane flagged [WAITING FOR YOU] but no explicit question
  4. idle-done       finished, nothing asked
  5. bare-shell      no agent running, free capacity
"""
import json
import os
import re
import subprocess
import sys
import time

ORCA = "/opt/homebrew/bin/orca"
ANSI = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")

RANK = {
    "ctx-critical": 0,
    "choice-prompt": 1,
    "asked-question": 2,
    "waiting": 3,
    "working": 4,
    "idle-done": 5,
    "bare-shell": 6,
}

# Terminal chrome that carries letters but is not agent output.
CHROME = ("Jump to bottom", "Enter to select", "Update installed",
          "auto mode", "bypass permissions", "shift+tab", "for agents",
          "Esc to cancel", "to interrupt")


def run(*args, timeout=30):
    argv = []
    for a in args:
        argv.extend(a.split()) if " " in a and not a.startswith("-") else argv.append(a)
    try:
        p = subprocess.run([ORCA] + argv, capture_output=True,
                           text=True, timeout=timeout)
        return p.stdout
    except Exception as e:
        print("orca call failed: %s" % e, file=sys.stderr)
        return ""


def terminals():
    """Parse `orca terminal list` into handle/title/cwd triples."""
    out = run("terminal list")
    rows = []
    for line in out.splitlines():
        if not line.startswith("term_"):
            continue
        parts = line.split()
        handle = parts[0]
        m = re.search(r"\s(connected|disconnected)\s+host=\S+\s+(\S.*)$", line)
        cwd = m.group(2).strip() if m else ""
        title = line[len(handle):]
        if m:
            title = title[:m.start() - len(handle)]
        title = title.strip().lstrip("*").strip()
        # Never watch ourselves: a board pane's screen is board output, and
        # classifying it scrapes our own rendered ctx%/state strings.
        if "ZORCA board" in title or "orca-board" in title:
            continue
        rows.append(dict(handle=handle, title=title,
                         cwd=cwd, repo=reponame(cwd)))
    return rows


def pending_gates():
    """Gates are Zaal's queue and live in orchestration, not on any screen."""
    out = run("orchestration", "gate-list", "--json")
    try:
        gates = json.loads(out).get("result", {}).get("gates", [])
        return [g for g in gates if g.get("status", "pending") == "pending"]
    except Exception:
        return []


def reponame(cwd):
    """Orca worktrees live at ~/orca/workspaces/<repo>/<branch-dir>."""
    m = re.search(r"/orca/workspaces/([^/]+)/", cwd)
    return m.group(1) if m else os.path.basename(cwd)


def screen(handle):
    return ANSI.sub("", run("terminal read", "--terminal", handle, "--screen"))


def classify(text):
    """Return (state, ctx_pct, question) for one pane's visible screen."""
    ctx = None
    m = re.search(r"ctx\s+(\d+)%", text)
    if m:
        ctx = int(m.group(1))

    waiting = "[WAITING FOR YOU]" in text
    has_agent = (waiting or ctx is not None or "auto mode" in text
                 or "bypass permissions" in text or "shift+tab" in text)

    # The agent's last substantive line, ignoring chrome.
    body = []
    for ln in text.splitlines():
        s = ln.strip().strip("│").strip()
        if not s or not re.search(r"[0-9A-Za-z]", s):
            continue
        # Pane-title dividers carry letters but are mostly box-drawing.
        if sum(c in "-─═╌_" for c in s) > len(s) * 0.5:
            continue
        if s.startswith(("❯", "handle:", "source:", "cursor:", "oldest",
                         "latest", "✻", "⏵", "[WAITING", "scope:")):
            continue
        if any(c in s for c in CHROME):
            continue
        body.append(s)

    # Questions wrap across terminal lines, so join the tail before searching.
    question = ""
    tailtext = " ".join(body[-14:])
    qs = re.findall(r"([A-Z][^.?!]{8,180}\?)", tailtext)
    if qs:
        # Prefer the most informative of the trailing questions, not the last.
        question = max(qs[-3:], key=len).strip()

    # A numbered picker waiting on a keypress. Cheapest block to clear.
    # Orca renders several footer variants ("Tab/Arrow keys to navigate",
    # "up/down to navigate", "n to add notes"), so key off the one constant.
    choice = "Enter to select" in text
    if choice:
        opts = re.findall(r"^\s*❯?\s*(\d)\.\s+(\S.*?)(?:\s{2,}[│┌└]|$)",
                          text, re.M)
        seen, uniq = set(), []
        for n, o in opts:
            if n not in seen:
                seen.add(n)
                uniq.append((n, o))
        # The prompt line sits just above the first option.
        m = re.search(r"^[│\s]*(\S[^\n]{15,}\?)\s*$", text, re.M)
        head = "PICKER"
        if m:
            head = "PICKER: " + m.group(1).strip("│ ")[:90]
        question = head + " -> " + " | ".join(
            "%s) %s" % (n, o.strip()[:34]) for n, o in uniq[:6])

    if choice:
        state = "choice-prompt"
    elif not has_agent:
        state = "bare-shell"
    elif ctx is not None and ctx >= 85:
        state = "ctx-critical"
    elif "[WORKING]" in text:
        # Actively generating - needs nothing, and prompting it now would
        # interleave with its own output.
        state = "working"
        question = ""
    elif question:
        state = "asked-question"
    elif waiting:
        state = "waiting"
    else:
        state = "idle-done"
    return state, ctx, question, (body[-1] if body else "")


def board(keep_screen=False):
    rows = []
    for t in terminals():
        sc = screen(t["handle"])
        state, ctx, question, tail = classify(sc)
        t.update(state=state, ctx=ctx, question=question, tail=tail,
                 rank=RANK[state])
        if keep_screen:
            t["screen"] = sc
        rows.append(t)
    rows.sort(key=lambda r: (r["rank"], -(r["ctx"] or 0)))
    return rows


DRAFT_PROMPT = """You are the ORCHESTRATOR'S AUTO-DRAFT, not Zaal. Zaal runs
many Claude Code panes at once; you unblock stalled ones on his behalf. Below
is the visible screen of one pane.

Write the next instruction for the pane. You may DECIDE between options the
pane offered; you may NOT assert facts about the world. The difference:
"go with option 2" is a decision. "the credits are topped up" is a world-fact
you cannot know. Rules:
- Decide. Pick an option and say which. Never "it depends" or "either works".
- Plain text only. No markdown, no emojis, no em dashes. Hyphens only.
- Under 60 words. These are terminal messages, not essays.
- If the pane is at high context, tell it to write a handoff and stop.
- If the pane offers numbered options, name the number.
- NEVER claim Zaal did, is doing, or will do anything - no payments, top-ups,
  logins, taps, sign-offs, or hardware changes. You cannot act outside this
  terminal and neither can he through you. If the pane's next step requires a
  real-world action by Zaal, output exactly: NEEDS-ZAAL
- If you genuinely cannot tell what is being asked, output exactly: NEEDS-ZAAL

Zaal's standing preferences: archive over delete, commit over push, back up
before consolidating, and never publish anything public he has not previewed.

PANE: %s (%s, ctx %s)
--- SCREEN ---
%s
--- END SCREEN ---

Output only the reply text."""


def draft(row):
    """Ask a headless Claude for the reply Zaal should send to this pane."""
    body = row.get("screen", "")
    tail = "\n".join(body.splitlines()[-70:])
    prompt = DRAFT_PROMPT % (row["repo"], row["state"],
                             row["ctx"] if row["ctx"] is not None else "?", tail)
    try:
        p = subprocess.run(["claude", "-p", prompt], capture_output=True,
                           text=True, timeout=180)
        return (p.stdout or p.stderr).strip()
    except Exception as e:
        return "draft failed: %s" % e


def render(rows):
    lines = []
    blocked = sum(1 for r in rows if r["rank"] <= 2)
    gates = pending_gates()
    lines.append("ORCA BOARD  %d panes, %d want you, %d gates pending  %s"
                 % (len(rows), blocked, len(gates), time.strftime("%H:%M:%S")))
    for g in gates[:6]:
        lines.append("   GATE %s" % (g.get("question", "?")[:100]))
    lines.append("")
    for i, r in enumerate(rows, 1):
        ctx = ("%d%%" % r["ctx"]) if r["ctx"] is not None else "  -"
        flag = "!!" if r["state"] == "ctx-critical" else "  "
        lines.append("%s%2d. %-24s %-15s ctx %-4s %s"
                     % (flag, i, r["repo"][:24], r["state"], ctx, r["handle"]))
        detail = r["question"] or r["tail"]
        if detail and r["rank"] <= 3:
            lines.append("       %s" % detail[:104])
    return "\n".join(lines)


def drafts(argv):
    """Draft a reply for every blocked pane. --send delivers them."""
    send = "--send" in argv
    rows = [r for r in board(keep_screen=True) if r["rank"] <= 3]
    if not rows:
        print("nothing blocked.")
        return
    print(render(rows))
    print("\n" + "=" * 78)
    for r in rows:
        print("\n%s  [%s]" % (r["repo"], r["state"]))
        if r["state"] == "choice-prompt":
            print("  -> picker, needs a keypress. %s" % r["question"][:150])
            continue
        text = draft(r)
        if text == "NEEDS-ZAAL" or text.startswith("draft failed"):
            print("  -> %s" % text)
            continue
        print("  draft: %s" % text.replace("\n", "\n         "))
        if send:
            out = run("terminal", "send", "--terminal", r["handle"],
                      "--text", text, "--enter")
            print("  SENT." if out is not None else "  send failed.")
    if not send:
        print("\n(dry run. add --send to deliver these.)")


LOG = os.path.expanduser("~/.zao/orca-board.log")
QUEUE = os.path.expanduser("~/.zao/orca-drafts.json")


def queue_read():
    try:
        return json.load(open(QUEUE))
    except Exception:
        return []


def queue_write(items):
    os.makedirs(os.path.dirname(QUEUE), exist_ok=True)
    json.dump(items, open(QUEUE, "w"), indent=1)


def queue_add(repo, handle, text, reason):
    items = queue_read()
    # One queued draft per pane. A pane that idles for hours would otherwise
    # accrue a fresh near-duplicate every tick (60 piled up overnight).
    if any(i["handle"] == handle for i in items):
        return False
    items.append(dict(id="d%d" % int(time.time() * 1000), repo=repo,
                      handle=handle, text=text, reason=reason,
                      ts=time.time()))
    queue_write(items)
    return True

# Never auto-answer a picker whose options look irreversible or outward-facing.
# These are Zaal's calls, not the loop's.
DANGER = ("license", "mit ", "publish", "public", "delete", "archive",
          "push", "merge", "force", "rotate", "credential", "secret",
          "permission", "irreversible", "third-party", "verbatim")


def logline(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    stamp = time.strftime("%H:%M:%S")
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (stamp, msg))
    print("%s %s" % (stamp, msg), flush=True)


def risky(row):
    blob = (row.get("question", "") + " " + row.get("tail", "")).lower()
    return [w.strip() for w in DANGER if w in blob]


NOTIFIER = "/opt/homebrew/bin/terminal-notifier"


def notify(title, message, handle=None):
    """macOS banner; clicking it focuses the pane in Orca (Zaal's ask
    2026-08-26: 'something is done, click it and go over to that terminal')."""
    cmd = [NOTIFIER, "-title", "ZORCA", "-subtitle", title,
           "-message", message[:120], "-group", handle or title]
    if handle:
        cmd += ["-execute", "%s terminal switch --terminal %s" % (ORCA, handle)]
    try:
        subprocess.run(cmd, capture_output=True, timeout=10)
    except Exception:
        pass


def auto(argv):
    """Watch every pane. When one stalls, draft its next step.

    Default policy after 2026-08-25: QUEUE drafts for a human tap in the
    zorca GUI. Only the mechanical class auto-sends: the handoff-and-stop
    instruction to a ctx-critical pane. Pass --send-all to restore full
    auto-send (not recommended; see PLAYBOOK).
    """
    sendall = "--send-all" in argv
    i = argv.index("--auto")
    every = int(argv[i + 1]) if len(argv) > i + 1 and argv[i + 1].isdigit() else 90
    cooldown = 240  # do not re-prompt the same pane faster than this
    lastsent = {}
    prevstate = {}
    logline("auto mode on, polling every %ds. log: %s" % (every, LOG))
    while True:
        try:
            rows = board(keep_screen=True)
        except Exception as e:
            logline("board failed: %s" % e)
            time.sleep(every)
            continue
        skip = [s for s in os.environ.get("ORCA_BOARD_SKIP", "").split(",") if s]
        # Banner on real transitions: a working pane that finished or now
        # needs Zaal. Never on first sight (startup would spam a banner per
        # pane), never repeats (state must change again first).
        for r in rows:
            prev = prevstate.get(r["handle"])
            cur = r["state"]
            if prev is not None and prev != cur and prev == "working":
                if cur in ("asked-question", "choice-prompt"):
                    notify("%s needs you" % r["repo"],
                           r.get("question") or "question waiting", r["handle"])
                elif cur == "idle-done":
                    notify("%s finished" % r["repo"],
                           r.get("tail") or "lane went quiet", r["handle"])
                elif cur == "ctx-critical":
                    notify("%s near compact" % r["repo"],
                           "ctx %s%% - handoff time" % r.get("ctx"), r["handle"])
            prevstate[r["handle"]] = cur
        for r in rows:
            if r["rank"] > 3:
                continue
            if any(s.lower() in r["repo"].lower() for s in skip):
                continue
            key = r["handle"]
            if time.time() - lastsent.get(key, 0) < cooldown:
                continue
            flags = risky(r)
            if r["state"] == "choice-prompt" or flags:
                logline("HOLD  %-22s %s" % (
                    r["repo"], "picker" if r["state"] == "choice-prompt"
                    else "matched %s" % ",".join(flags[:3])))
                logline("      %s" % (r["question"] or r["tail"])[:150])
                continue
            # Relay-loop guard (2026-08-26): if the pane's most recent input
            # was an orchestrator relay or auto-draft, the pane is digesting
            # it - drafting a follow-up now produces replies to our own
            # messages, which the estate lane caught as "copies of this text".
            tail_in = r.get("screen", "")[-1500:]
            if "[orchestrator relay" in tail_in or "[auto-draft" in tail_in:
                continue
            text = draft(r)
            if text == "NEEDS-ZAAL" or text.startswith("draft failed"):
                logline("HOLD  %-22s %s" % (r["repo"], text[:60]))
                continue
            # Screen the DRAFT too, not just the pane: a stalled pane with an
            # innocuous question can still get a draft instructing something
            # irreversible (happened 2026-08-25: draft told a pane to close a
            # live upstream PR and delete its fork).
            bad = [w.strip() for w in DANGER if w in text.lower()]
            if bad:
                if queue_add(r["repo"], key, text, "draft matched " + ",".join(bad[:3])):
                    logline("QUEUE %-22s draft matched %s -> GUI"
                            % (r["repo"], ",".join(bad[:3])))
                continue
            # Mechanical class auto-sends; judgment calls queue for a tap.
            mechanical = r["state"] == "ctx-critical"
            if not (mechanical or sendall):
                if queue_add(r["repo"], key, text, "judgment call"):
                    logline("QUEUE %-22s -> GUI  %s"
                            % (r["repo"], text.replace("\n", " ")[:90]))
                lastsent[key] = time.time()
                continue
            # Provenance tag: the pane must know this is machine-drafted, not
            # Zaal. Panes are briefed to treat [auto] claims as unverified.
            tagged = "[auto-draft, not Zaal - verify any factual claim] " + text
            run("terminal", "send", "--terminal", key, "--text", tagged, "--enter")
            lastsent[key] = time.time()
            logline("SENT  %-22s %s" % (r["repo"], text.replace("\n", " ")[:130]))
            # Receipt check: two briefs were silently eaten today (one by a
            # compact, one by a session restart). Confirm the pane actually
            # holds the text; a send is not a delivery.
            time.sleep(6)
            probe = text[:40].strip()
            if probe and probe not in screen(key):
                logline("DROPPED %-20s pane does not show the sent text - "
                        "resend needed" % r["repo"])
                lastsent[key] = 0  # allow immediate retry next tick
        time.sleep(every)


def tail(argv):
    """Follow one pane by repo name, so you can watch a channel live."""
    i = argv.index("--tail")
    want = argv[i + 1].lower() if len(argv) > i + 1 else ""
    rows = [r for r in board() if want in r["repo"].lower()]
    if not rows:
        print("no pane matching %r. panes: %s"
              % (want, ", ".join(r["repo"] for r in board())))
        return
    h = rows[0]["handle"]
    print("following %s (%s). ctrl-c to stop.\n" % (rows[0]["repo"], h))
    last = ""
    while True:
        sc = screen(h)
        if sc != last:
            print("\033[2J\033[H" + sc, flush=True)
            last = sc
        time.sleep(5)


def main():
    argv = sys.argv[1:]
    if "--json" in argv:
        print(json.dumps(board(), indent=1))
        return
    if "--draft" in argv:
        drafts(argv)
        return
    if "--auto" in argv:
        auto(argv)
        return
    if "--tail" in argv:
        tail(argv)
        return
    if "--watch" in argv:
        i = argv.index("--watch")
        every = int(argv[i + 1]) if len(argv) > i + 1 and argv[i + 1].isdigit() else 60
        last = None
        while True:
            rows = board()
            now = render(rows)
            if now.split("\n", 1)[1] != (last or ""):
                print("\n" + now, flush=True)
                last = now.split("\n", 1)[1]
            time.sleep(every)
    rows = board()
    print(render(rows))
    if "--jump" in argv and rows:
        top = rows[0]
        run("terminal switch", "--terminal", top["handle"])
        print("\njumped to %s (%s)" % (top["repo"], top["state"]))


if __name__ == "__main__":
    main()
