#!/bin/bash
# zorca-actuator-test - exercise the stage-1 chain without touching Orca.
#
# Runs the actuator against a sandboxed HOME, a fixture queue file, and a
# stub `orca`, so no pane is ever created and no paid session is spawned.
# Every case here is a hazard the design names; if one regresses, a real
# /lane either spends money twice or reports a lane nobody was told about.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
S="$(mktemp -d)"; trap 'rm -rf "$S"' EXIT
mkdir -p "$S/.zao"
PASS=0; FAIL=0
ok(){ if [ "$1" = "$2" ]; then PASS=$((PASS+1)); echo "  ok   $3"; \
      else FAIL=$((FAIL+1)); echo "  FAIL $3 (want '$2' got '$1')"; fi; }

cat > "$S/fake-orca" <<'STUB'
#!/bin/bash
case "$1 $2" in
  "orchestration run-use") echo "Using Run $4";;
  "terminal create") echo "Created terminal term_stub123";;
  "orchestration task-create") echo "Created task_stub456";;
  "terminal read") [ -f "$FAKE_PANE_EMPTY" ] && echo "empty prompt" || echo "pane holds task_stub456";;
  *) echo ok;;
esac
exit 0
STUB
chmod +x "$S/fake-orca"
export FAKE_PANE_EMPTY="$S/pane-empty"
A(){ HOME="$S" ZORCA_ORCA_BIN="$S/fake-orca" "$ROOT/bin/zorca-actuator" "$@" 2>&1; }
cfg(){ cat > "$S/.zao/zorca-actuator.json" <<J
{"gui_port": $1, "run_id": "run_test", "poll_seconds": 10,
 "queue": {"mode": "local", "path": "$S/lane.jsonl"}}
J
}
FUT(){ python3 -c "import time;print(time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(time.time()+3600)))"; }
PAST(){ python3 -c "import time;print(time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(time.time()-3600)))"; }

echo "config refuses to guess:"
rm -f "$S/.zao/zorca-actuator.json"; A --check >/dev/null 2>&1; ok "$?" "2" "no config is fatal"
echo '{"gui_port":7777}' > "$S/.zao/zorca-actuator.json"
ok "$(A --check | grep -c 'queue.mode')" "1" "missing keys named, not defaulted"
echo '{"gui_port":7777,"run_id":"r","poll_seconds":5,"queue":{"mode":"pigeon","path":"/tmp/q"}}' > "$S/.zao/zorca-actuator.json"
ok "$(A --check | grep -c 'must be')" "1" "unknown queue mode refused"
cfg 7999
ok "$(A --check | grep -c 'never guessed')" "1" "unreachable gui_port is fatal, no fallback"

GUI_PORT="${ZORCA_TEST_GUI_PORT:-7777}"
if ! curl -sf -o /dev/null --max-time 3 "http://127.0.0.1:$GUI_PORT/api/state"; then
  echo "  SKIP drain cases - no GUI on $GUI_PORT (start with: zorca up)"
  echo "$PASS passed, $FAIL failed"; [ "$FAIL" -eq 0 ] || exit 1; exit 0
fi
cfg "$GUI_PORT"

echo "ttl:"
: > "$S/lane.jsonl"; rm -f "$S/.zao/zorca-actuator-state.json"
echo "{\"type\":\"lane\",\"id\":\"e1\",\"expiresAt\":\"$(PAST)\",\"request\":\"stale\"}" >> "$S/lane.jsonl"
echo "{\"type\":\"lane\",\"id\":\"e2\",\"request\":\"no ttl\"}" >> "$S/lane.jsonl"
OUT="$(A --once)"
ok "$(echo "$OUT" | grep -c 'EXPIRED e1')" "1" "past TTL refused, no pane"
ok "$(echo "$OUT" | grep -c 'EXPIRED e2')" "1" "missing TTL refused, no pane"

echo "chain + readback:"
: > "$S/lane.jsonl"; rm -f "$S/.zao/zorca-actuator-state.json"
"$ROOT/bin/zorca-lane-enqueue" --queue "$S/lane.jsonl" --principal 1 --request "good" >/dev/null
OUT="$(A --once)"
ok "$(echo "$OUT" | grep -c '\-\-inject')" "0" "dispatch runs (inject asserted in dry-run case)"
ok "$(echo "$OUT" | grep -c 'DONE')" "1" "readback passes -> DONE"
: > "$S/lane.jsonl"; rm -f "$S/.zao/zorca-actuator-state.json"; touch "$S/pane-empty"
"$ROOT/bin/zorca-lane-enqueue" --queue "$S/lane.jsonl" --principal 1 --request "truncated" >/dev/null
ok "$(A --once | grep -c 'not confirmed in pane')" "1" "empty pane -> ERROR, never reported briefed"
rm -f "$S/pane-empty"

echo "exactly-once:"
: > "$S/lane.jsonl"; rm -f "$S/.zao/zorca-actuator-state.json"
"$ROOT/bin/zorca-lane-enqueue" --queue "$S/lane.jsonl" --principal 1 --request "once" >/dev/null
A --once >/dev/null
ok "$(A --once | grep -c CLAIMED)" "0" "second drain does not re-run"
rm -f "$S/.zao/zorca-actuator-state.json"
ok "$(A --once | grep -c CLAIMED)" "0" "state file destroyed: queue result still blocks a duplicate pane"

echo "reaper:"
python3 -c "
import json,sys;json.dump({'z9':{'status':'claimed','ts':'2026-01-01T00:00:00Z'}},open('$S/.zao/zorca-actuator-state.json','w'))"
ok "$(A --once | grep -c 'REAPED z9')" "1" "in-flight row from a dead process is closed, not left claimed"

echo "dry run:"
: > "$S/lane.jsonl"
"$ROOT/bin/zorca-lane-enqueue" --queue "$S/lane.jsonl" --principal 1 --request "dry" >/dev/null
OUT="$(A --once --dry-run)"
ok "$(echo "$OUT" | grep -c 'dispatch .*--inject')" "1" "dispatch always carries --inject"
ok "$(echo "$OUT" | grep -c 'DRY orca orchestration run-use')" "1" "run-use runs first, unconditionally"
ok "$(echo "$OUT" | grep -n 'DRY orca' | head -1 | grep -c 'run-use')" "1" "run-use is the FIRST orca call, before any pane exists"

echo "enqueue refusals:"
"$ROOT/bin/zorca-lane-enqueue" --queue "$S/lane.jsonl" --principal zaal --request x >/dev/null 2>&1
ok "$?" "2" "non-numeric principal refused"

echo
echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ] || exit 1
