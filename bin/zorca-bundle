#!/bin/zsh
# zorca-bundle - bundle every repo with unpushed or unbacked commits, local only.
# Nightly via ~/Library/LaunchAgents/com.zao.zorca-bundle.plist (02:00).
# Never pushes. Output: ~/.zao/backups/<date>/<repo>.bundle + one daily line.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$PATH
D="$HOME/.zao/backups/$(date +%F)"; mkdir -p "$D"; n=0; skipped=0; lines=()
for r in "$HOME/Documents"/*/ "$HOME/Desktop/repos"/*/ "$HOME/orca/workspaces"/*/*/ "$HOME/zao-vault/" "$HOME/zaal-dotfiles/"; do
  [ -e "$r/.git" ] || continue
  name=$(basename "${r%/}"); [[ "$r" == */orca/workspaces/* ]] && name="$(basename "$(dirname "${r%/}")")--$name"
  # unpushed = commits on any local branch not on any remote ref
  ahead=$(git -C "$r" rev-list --count --branches --not --remotes 2>/dev/null || echo 0)
  [ "${ahead:-0}" -gt 0 ] || { skipped=$((skipped+1)); continue; }
  if git -C "$r" bundle create "$D/$name.bundle" --all --quiet 2>/dev/null; then n=$((n+1)); lines+=("$name:$ahead"); fi
done
# keep 7 nights
ls -1d "$HOME/.zao/backups"/20*/ 2>/dev/null | sort | head -n -7 | xargs -I{} rm -rf {} 2>/dev/null
SUM="bundles $(date '+%F %H:%M'): $n repos with unpushed commits -> $D (${(j:, :)lines}); $skipped clean"
echo "$SUM"; echo "$SUM" >> "$HOME/.zao/backups/bundle.log"
DAILY="$HOME/zao-vault/daily/$(date +%F).md"; [ -f "$DAILY" ] && printf '\n- %s\n' "$SUM" >> "$DAILY"
