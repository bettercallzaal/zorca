#!/bin/zsh
# zorca-brief <terminal-handle> <brief-file> [constraint]
# Briefs are files. Sends a pane ONE short line pointing at the file, never the
# brief itself: `orca terminal send` drops the head of long messages into
# recently-compacted panes (six measured cases, 2026-08-26/27), so a long send
# is a brief that never arrives. Verifies the send was accepted and logs it.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:$HOME/bin:$PATH
set -u
H="${1:?terminal handle}"; F="${2:?brief file}"; C="${3:-no push, no outbound sends, UNSET for any figure Zaal has not typed}"
[ -s "$F" ] || { echo "zorca-brief: $F missing or empty" >&2; exit 2; }
F=$(cd "$(dirname "$F")" && pwd)/$(basename "$F")
MSG="[orchestrator relay] Your brief is a file: read $F in full and follow it. Reply with the report shape it names. Constraint last: $C"
OUT=$(orca terminal send --terminal "$H" --text "$MSG" --enter --json 2>&1)
if echo "$OUT" | grep -q '"accepted": true'; then
  echo "$(date '+%F %H:%M') BRIEF $H <- $F" >> "$HOME/.zao/orca-board.log"; echo "sent: $H <- $F"
else
  echo "zorca-brief: NOT accepted for $H" >&2; echo "$OUT" | head -5 >&2; exit 1
fi
