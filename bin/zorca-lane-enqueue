#!/usr/bin/env python3
"""
zorca-lane-enqueue - append one /lane request to the queue file.

The VPS side of stage 1 (docs/DESIGN-bridge.md section 12). ZOE's webhook
handler calls this after Zaal confirms; it is also the executable definition
of the queue record, so the format cannot drift between the two halves.

Usage:
  zorca-lane-enqueue --queue <path> --principal <tg-user-id> \
                     --request "<what the lane should do>" \
                     [--repo <name>] [--worktree <path>] [--ttl-minutes 90]

Exits 2 on a refused request. A TTL is mandatory: the actuator refuses a
record without one, because a request with no expiry can spawn a paid pane
hours after it stopped being wanted.
"""
import argparse
import json
import os
import sys
import time
import uuid

DEFAULT_TTL_MIN = 90


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--queue", required=True)
    ap.add_argument("--principal", required=True,
                    help="numeric Telegram user id; usernames are reassignable")
    ap.add_argument("--request", required=True)
    ap.add_argument("--repo", default="")
    ap.add_argument("--worktree", default="")
    ap.add_argument("--ttl-minutes", type=int, default=DEFAULT_TTL_MIN)
    a = ap.parse_args()

    if not a.request.strip():
        print("refused: empty request", file=sys.stderr)
        sys.exit(2)
    if not a.principal.strip().isdigit():
        print("refused: principal must be a numeric Telegram user id, got %r"
              % a.principal, file=sys.stderr)
        sys.exit(2)
    if a.ttl_minutes < 1:
        print("refused: ttl-minutes must be >= 1", file=sys.stderr)
        sys.exit(2)

    now = time.time()
    rec = dict(
        type="lane",
        id="req_" + uuid.uuid4().hex[:12],
        ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        expiresAt=time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                time.gmtime(now + a.ttl_minutes * 60)),
        principal=a.principal.strip(),
        request=a.request.strip(),
    )
    if a.repo:
        rec["repo"] = a.repo
    if a.worktree:
        rec["worktree"] = a.worktree

    d = os.path.dirname(a.queue) or "."
    if not os.path.isdir(d):
        print("refused: queue directory %s does not exist" % d, file=sys.stderr)
        sys.exit(2)
    with open(a.queue, "a") as f:
        f.write(json.dumps(rec, separators=(",", ":")) + "\n")
    print(rec["id"])


if __name__ == "__main__":
    main()
