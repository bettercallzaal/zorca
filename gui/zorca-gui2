# Per-path rate limits: (max requests, window seconds).
#
# Only these two. /api/resolve dedupes on the gate id and /api/draft drops
# the item from the queue as it sends, so a wedged loop hitting either is
# bounded by its own state. /api/focus is idempotent. These two are the
# unbounded ones: an ack can be written forever, and a lane creates a
# terminal that starts a PAID session every time.
LIMITS = {
    "/api/lane": (int(os.environ.get("ZORCA_LANE_MAX", "3")),
                  int(os.environ.get("ZORCA_LANE_WINDOW", "300"))),
    "/api/ack": (int(os.environ.get("ZORCA_ACK_MAX", "30")),
                 int(os.environ.get("ZORCA_ACK_WINDOW", "60"))),
}
HITS = {}
HITS_LOCK = threading.Lock()


def rate_check(ip, path, now=None):
    """(allowed, retry_after_seconds).

    A sliding window rather than a counter that resets on the minute: a
    reset boundary lets a loop fire the whole allowance twice back to back
    and still look compliant.

    Keyed per (ip, path). Everything here is 127.0.0.1 by design, so in
    practice this is one bucket per endpoint - which is what is wanted, since
    the thing being limited is a wedged loop on this machine, not a crowd.
    """
    limit = LIMITS.get(path)
    if not limit:
        return True, 0
    cap, window = limit
    now = now or time.time()
    key = (ip, path)
    with HITS_LOCK:
        seen = [t for t in HITS.get(key, []) if now - t < window]
        if len(seen) >= cap:
            HITS[key] = seen
            return False, max(1, int(window - (now - seen[0])) + 1)
        seen.append(now)
        HITS[key] = seen
    return True, 0


# Only these may appear as the Host or the Origin's hostname. Everything
# else is either a cross-origin page in Zaal's browser or a DNS-rebind
# pointing a hostile name at 127.0.0.1.
LOCAL_HOSTS = {"127.0.0.1", "localhost", "::1", "[::1]"}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def local_only(self):
        """CORS blocks a cross-origin page from READING the reply. It does
        not stop the request being SENT and acted on, and every /api POST
        here acts on something - resolves a gate, sends a draft to a live
        pane. So the request itself is refused, not just its response.

        Three checks, because each covers a hole the others leave:
          Host    - a DNS rebind resolves evil.example to 127.0.0.1 and the
                    Origin then looks legitimate; the Host header does not.
          Origin  - a browser always sends it on a cross-origin POST. It is
                    absent for curl and for local scripts, and absence is
                    allowed, because the attack this defends against is a
                    page in a browser and that page cannot omit it.
          Sec-Fetch-Site - belt to the Origin's braces where the browser
                    sends it.
        """
        host = (self.headers.get("Host") or "").strip()
        if host.startswith("["):
            host = host.split("]")[0] + "]"
        else:
            host = host.rsplit(":", 1)[0] if ":" in host else host
        if host not in LOCAL_HOSTS:
            return False, "Host %r is not local" % host[:60]
        origin = (self.headers.get("Origin") or "").strip()
        if origin and origin.lower() != "null":
            try:
                hostname = urllib.parse.urlparse(origin).hostname or ""
            except Exception:
                hostname = ""
            if hostname not in LOCAL_HOSTS:
                return False, "Origin %r is cross-site" % origin[:60]
        elif origin.lower() == "null":
            # A sandboxed iframe or a data: URL. Nothing legitimate here
            # sends that.
            return False, "Origin null"
        site = (self.headers.get("Sec-Fetch-Site") or "").strip().lower()
        if site and site not in ("same-origin", "same-site", "none"):
            return False, "Sec-Fetch-Site %r" % site[:40]
        return True, ""

    def guard(self):
        ok, why = self.local_only()
        if not ok:
            self._send(403, json.dumps({"ok": False, "why": why}))
        return ok

    def rate_ok(self):
        ip = (self.client_address or ["?"])[0]
        allowed, retry = rate_check(ip, self.path)
        if not allowed:
            cap, window = LIMITS[self.path]
            body = json.dumps({"ok": False, "retry_after": retry,
                               "why": "rate limit: %d per %ds on %s - retry in %ds"
                                      % (cap, window, self.path, retry)})
            data = body.encode()
            self.send_response(429)
            self.send_header("Content-Type", "application/json")
            self.send_header("Retry-After", str(retry))
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return False
        return True

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self.guard():
            return
        if self.path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif self.path.split("?")[0] == "/api/state":
            # `tasks` and `resolved` are 26 KB of the payload and render
            # only inside the reference fold, which is closed by default.
            # Sending them on every 15s poll ships data nobody is looking
            # at; the counts the strip needs are two small numbers. The
            # fold asks for the rest when it opens.
            want = "detail=1" in self.path
            with LOCK:
                if want:
                    body = json.dumps(CACHE)
                else:
                    lean = {k: v for k, v in CACHE.items()
                            if k not in ("tasks", "resolved")}
                    body = json.dumps(lean)
            self._send(200, body)
        else:
            self._send(404, "{}")

    def do_POST(self):
        if not self.guard():
            return
        if not self.rate_ok():
            return
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n) or "{}")
        except Exception:
            body = {}
        if self.path == "/api/resolve" and body.get("id") and body.get("resolution"):
            # Belt to the client's braces: even if a second tap escapes the
            # in-flight guard, it must not shell out a second gate-resolve.
            with LOCK:
                if body["id"] in RESOLVED:
                    self._send(200, json.dumps({"ok": True, "dup": True}))
                    return
            if not is_token(body["id"]):
                self._send(400, json.dumps({"ok": False, "why": "bad gate id"}))
                return
            out = sh([ORCA, "orchestration", "gate-resolve",
                      flag("id", body["id"]),
                      flag("resolution", body["resolution"]), "--json"])
            ok = '"ok": true' in out or '"ok":true' in out
            if ok:
                with LOCK:
                    RESOLVED.add(body["id"])
            threading.Thread(target=refresh_coalesced, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/focus" and body.get("handle"):
            if not is_token(body["handle"]):
                self._send(400, json.dumps({"ok": False, "why": "bad handle"}))
                return
            sh([ORCA, "terminal", "switch", flag("terminal", body["handle"])])
            self._send(200, '{"ok": true}')
        elif self.path == "/api/lane" and body.get("i") is not None:
            lanes = load_lanes()
            ok = False
            try:
                l = lanes[int(body["i"])]
                # Zaal's tap: open an Orca pane in the lane's worktree and
                # resume its Claude session. Spawns a paid session - which is
                # exactly what the button says it does.
                if l.get("bad") or not l.get("cmd"):
                    self._send(400, json.dumps(
                        {"ok": False, "why": l.get("bad") or "no command"}))
                    return
                out = sh([ORCA, "terminal", "create",
                          flag("worktree", "path:" + l["worktree"]),
                          flag("title", l["name"]),
                          flag("command", l["cmd"]), "--focus"], timeout=120)
                ok = "Created terminal" in out
            except Exception:
                pass
            threading.Thread(target=refresh_coalesced, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/ack" and body.get("key"):
            # SPEC 2420 put new mutation endpoints out of scope. That guard
            # was about mutations that REACH ORCA - resolve, send, focus,
            # create - which are irreversible and outward-facing. This one
            # writes a single zorca-owned file, shells out to nothing, sends
            # nothing to any pane, and is undone by tapping again. The
            # alternative, localStorage, would give the phone and the laptop
            # different counts for the same board, which is worse than the
            # deviation.
            with ACK_LOCK:
                d = acks_read()
                if body.get("action") == "unack":
                    d.pop(body["key"], None)
                else:
                    d[body["key"]] = time.time()
                acks_write(d)
            threading.Thread(target=refresh_coalesced, daemon=True).start()
            self._send(200, json.dumps({"ok": True}))
        elif self.path == "/api/draft" and body.get("id"):
            item = next((i for i in queue_read() if i["id"] == body["id"]), None)
            ok = True
            if item and body.get("action") == "send":
                # The human tapped Send - this is Zaal's keystroke, so no
                # auto-draft prefix; it carries his authority.
                if not is_token(item.get("handle")):
                    self._send(400, json.dumps(
                        {"ok": False, "why": "bad handle in the queue"}))
                    return
                out = sh([ORCA, "terminal", "send",
                          flag("terminal", item["handle"]),
                          flag("text", item["text"]), "--enter"])
                ok = "Sent" in out
            if item:
                queue_drop(body["id"])
            threading.Thread(target=refresh_coalesced, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        else:
            self._send(400, '{"ok": false}')


def main():
    port = PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    threading.Thread(target=refresher, daemon=True).start()
    print("ZORCA GUI2 on http://127.0.0.1:%d  (ctrl-c to stop)" % port)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


if __name__ == "__main__":
    main()
