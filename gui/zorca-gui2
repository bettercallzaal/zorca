  if (INFLIGHT.has(key)) return;
  INFLIGHT.add(key);
  if (el) { el.disabled = true; el.dataset.was = el.textContent; el.textContent = "..."; }
  let ok = false, why = "";
  try {
    const r = await fetch(url, {method:"POST", body: JSON.stringify(body)});
    ok = r.ok;
    if (!ok) why = " (" + r.status + ")";
  } catch (e) {
    why = " (no server)";
  }
  toast(ok ? "done" : "failed" + why, ok);
  INFLIGHT.delete(key);
  if (el && el.dataset.was) { el.disabled = false; el.textContent = el.dataset.was; }
  load();
}
function toast(msg, ok){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.className = ok ? "" : "bad";
  t.style.display = "block";
  setTimeout(()=>t.style.display="none", ok ? 1800 : 4000);
}
function esc(s){ const d=document.createElement("div"); d.textContent=s||""; return d.innerHTML; }
/* esc() leaves quotes alone, which is fine for text and NOT fine inside a
   single-quoted onclick. Lane names come from a markdown table and worktree
   paths come from disk; either can contain an apostrophe, and one would end
   the attribute early. */
function attr(s){ return esc(s).replace(/'/g, "&#39;").replace(/"/g, "&quot;"); }
/* A JS value safe to drop inside a single-quoted onclick. JSON.stringify
   alone is not enough: it escapes double quotes and leaves apostrophes
   alone, so a gate option reading "don't merge" ends the attribute and the
   rest of the option becomes markup. Every interpolated value goes through
   this - ids, handles and free text alike - because "this one is a UUID"
   stops being true the day something upstream changes format. */
function js(v){ return attr(JSON.stringify(v)); }

/* ZORCA already holds danger-worded drafts on rail 1. The GUI was the one
   surface where that hold was invisible - this only renders it. No override
   is added: a held draft is still sendable, it just costs a second tap. */
const DANGER = /license|publish|delete|archive|push|merge|rotate|credential/i;
function danger(reason){
  const m = DANGER.exec(reason || "");
  return m ? m[0].toLowerCase() : "";
}
/* The "last look" mark. Read once per page load: the value in storage is
   the PREVIOUS visit, and now is stamped over it immediately, so polling
   every 15s does not erase the marker mid-session. Storage can throw
   (private window, blocked site data) - a feed with no NEW marks is still a
   feed, so every access is guarded and failure is silent by design. */
let SEEN = null;
function seenAt(){
  if (SEEN !== null) return SEEN;
  let prev = 0;
  try { prev = Number(localStorage.getItem("zorca.seen")) || 0; } catch (e) {}
  try { localStorage.setItem("zorca.seen", String(Math.floor(Date.now()/1000))); } catch (e) {}
  SEEN = prev;
  return SEEN;
}

/* One feed out of two sources, newest first. An event whose time would not
   parse server-side arrives with ts 0: it is never called new, and it is
   never dropped - a "what happened" surface that hides an event it could
   not date is worse than one that admits it (parse, do not sort - a979b96). */
function feed(s){
  const rows = [];
  (s.daily || []).forEach(d => rows.push({
    ts: d.ts, tag: "vault", kind: "vault",
    text: d.detail ? d.text + " - " + d.detail : d.text, src: d.src }));
  (s.gitlog || []).forEach(g => rows.push({
    ts: g.ts, tag: "git", kind: "git",
    text: g.repo + " " + g.sha + " " + g.text, src: g.src }));
  rows.sort((a, b) => (b.ts || 0) - (a.ts || 0));
  return rows;
}

function renderFeed(s){
  const all = feed(s), mark = seenAt();
  const fresh = all.filter(r => r.ts && r.ts > mark).length;
  document.getElementById("sincecount").textContent =
    mark === 0 ? "first look on this browser - showing the latest"
    : fresh === 0 ? "nothing new since " + new Date(mark*1000).toLocaleTimeString()
    : fresh + " new since " + new Date(mark*1000).toLocaleTimeString();
  // Three on a phone, not four. The stat cells grew when every one of them
  // started naming its source, and the action list must stay above the fold
  // (milestone 4). The feed is context; the decisions are the point.
  // On a phone the feed is prose, and prose above the action list is
  // reading cost. The COUNT stays visible at the top - that is the stat -
  // and the rows themselves sit one tap down, which is where reading
  // belongs. A laptop has the room, so it stays open there.
  // The fold threshold is wider than the phone breakpoint on purpose: a
  // 768-wide window has a laptop's layout and a phone's height budget, and
  // six rows of prose put the action list under the fold there too.
  const phone = window.innerWidth <= 900;
  const el = document.getElementById("since");
  if (el.dataset.userset !== "1") el.open = !phone;
  const show = all.slice(0, 5);
  document.getElementById("feed").innerHTML = show.map(r => {
    const isNew = r.ts && r.ts > mark;
    const when = r.ts ? new Date(r.ts*1000).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"})
                      : "??:??";
    return `<div class="ev ${r.kind}${isNew ? " new" : ""}">
      <span class="evtime">${when}</span>
      <span class="evtag">${r.tag}</span>
      ${isNew ? '<span class="evnew">NEW</span>' : ""}
      <span class="evtext">${esc(r.text)}</span>
      <span class="evsrc">${esc(r.ts ? r.src : r.src + " (time unreadable - shown anyway)")}</span>
    </div>`;
  }).join("") || '<div class="card">no events today - ' +
    'vault daily log and worktree commits are both empty</div>';
  if (all.length > show.length) {
    document.getElementById("feed").innerHTML +=
      `<div class="stamp">${all.length - show.length} older not shown</div>`;
  }
}

/* Gate timestamps arrive as "YYYY-MM-DD HH:MM[:SS]"; anything else is
   treated as unknown age rather than guessed at. */
function parseTs(v){
  if (!v) return 0;
  const t = Date.parse(String(v).replace(" ", "T"));
  return isNaN(t) ? 0 : t / 1000;
}

/* One queue out of three sources. Order is irreversibility first, then
   oldest - a send that cannot be taken back outranks a lane that is merely
   blocked, and an unknown age sorts last rather than pretending to be new. */
function actions(s){
  const out = [];
  (s.drafts || []).forEach(d => {
    const hit = danger((d.reason || "") + " " + (d.text || ""));
    out.push({
      tier: hit ? 0 : 3,
      tag: hit ? "IRREVERSIBLE" : "SEND",
      who: d.repo,
      why: hit ? "danger word: " + hit : (d.reason || "queued draft"),
      ts: d.ts || 0,
      text: d.text || "",
      buttons: `<button onclick='sendDraft(${js(d.id)}, this, ${hit ? "true" : "false"})'>Send</button>
        <button onclick='post("/api/draft",{id:${js(d.id)},action:"skip"}, this)'>Skip</button>`
    });
  });
  (s.panes || []).filter(p => p.rank === 0).forEach(p => {
    out.push({
      tier: 1, tag: "CONTEXT", who: p.repo,
      why: p.ctx == null ? "context critical" : p.ctx + "% - hand off now",
      ts: 0, text: p.question || p.tail || "",
      buttons: `<button onclick='post("/api/focus",{handle:${js(p.handle)}}, this)'>open the pane</button>`
    });
  });
  (s.gates || []).forEach((g, gi) => {
    // The input's id is built from the loop index, not the gate id. An id
    // has to survive being written into an attribute AND read back through
    // getElementById inside another attribute, and the only value that
    // reliably does that is one we chose ourselves.
    const inputId = "gate-answer-" + gi;
    const opts = (g.options || []).map(o =>
      `<button onclick='post("/api/resolve",{id:${js(g.id)},resolution:${js(o)}}, this)'>${esc(o)}</button>`).join("");
    const close = (g.options || []).length === 0
      ? `<button onclick='post("/api/resolve",{id:${js(g.id)},resolution:${js("Closed by Zaal from ZORCA GUI: addressed, no further action.")}}, this)'>close - addressed</button>`
      : "";
    out.push({
      tier: 2, tag: "BLOCKED", who: "decision gate",
      why: "a lane is waiting on your call",
      ts: parseTs(g.created_at), text: g.question || "",
      buttons: opts + close +
        `<input type="text" id="${inputId}" placeholder="or type an answer">
         <button onclick='post("/api/resolve",{id:${js(g.id)},
           resolution:document.getElementById(${js(inputId)}).value}, this)'>send</button>`
    });
  });
  (s.panes || []).filter(p => p.rank === 1 || p.rank === 2).forEach(p => {
    out.push({
      tier: 4, tag: "ASKED", who: p.repo, why: esc(p.state),
      ts: 0, text: p.question || p.tail || "",
      buttons: `<button onclick='post("/api/focus",{handle:${js(p.handle)}}, this)'>open the pane</button>`
    });
  });
  const LAST = 1e18;
  out.sort((a, b) => (a.tier - b.tier) || ((a.ts || LAST) - (b.ts || LAST)));
  return out;
}

function actRow(a){
  const age = a.ts ? ago(Date.now()/1000 - a.ts) + " old" : "";
  return `<div class="act t${a.tier}">
    <div class="actline">
      <span class="tier">${a.tag}</span>
      <span class="who">${esc(a.who)}</span>
      <span class="why">${a.why}</span>
      <span class="age">${age}</span>
    </div>
    <div class="detail dtext" style="white-space:normal"
      onclick='expand(this)'>${esc(a.text)}</div>
    <span class="dmore" onclick='expand(this.previousElementSibling, this)'
      >show all &darr;</span>
    <div class="acts">${a.buttons}</div>
  </div>`;
}

/* A lane claiming to work with nothing landed since the claim began.
   "held" is measured by zorca watching the state change, so a pane first
   seen already working reports "at least" - a duration we did not observe
   is never reported as one we did. */
/* An ack says "I know about this one, as of then". It is a statement about
   a moment, so the moment is always shown and goes stale on its own - an ack
   that has quietly covered an item for nine days is a different thing from
   one made this morning, and the row says which.

   Keys embed the fact they describe, so acking "stuck since 14:02" does not
   cover "stuck since 16:40" - a fresh claim makes a fresh key and the item
   comes back unhandled. */
function ackOf(s, key){
  const at = (s.acks || {})[key];
  return typeof at === "number" ? at : null;
}
function unhandled(s, rows){
  return (rows || []).filter(r => !ackOf(s, r.key));
}
function ackBar(s, key){
  const at = ackOf(s, key);
  const k = attr(JSON.stringify(key));
  if (!at) {
    return `<div class="ackline"><button class="mini ack"
      onclick='post("/api/ack",{key:${k},action:"ack"}, this)'
      >I know about this</button></div>`;
  }
  const age = Date.now()/1000 - at;
  const stale = age > (s.ack_stale_s || 604800);
  return `<div class="ackline">acked <b class="${stale ? "stale" : ""}">${ago(age)} ago</b>` +
    (stale ? " - and still here" : "") +
    ` <button class="mini ack"
      onclick='post("/api/ack",{key:${k},action:"unack"}, this)'>unack</button></div>`;
}

function renderStuck(s){
  const all = s.stuck || [];
  const rows = unhandled(s, all), ackedN = all.length - rows.length;
  const ordered = rows.concat(all.filter(r => ackOf(s, r.key)));
  document.getElementById("stuckcount").innerHTML = rows.length === 0
    ? "nothing unhandled" + (ackedN ? ` - ${ackedN} acked` :
        " - every working lane has landed something since it started")
    : rows.length + " claiming to work with nothing landed"
      + (ackedN ? ` &middot; ${ackedN} acked` : "");
  document.getElementById("stuck").classList.toggle("clear", rows.length === 0);
  document.getElementById("jams").innerHTML = ordered.map(r => `
    <div class="jam${ackOf(s, r.key) ? " acked" : ""}">
      <div class="jamline">
        <span class="who">${esc(r.repo)}</span>
        <span class="chip r${r.state === "working" ? 4 : 3}">${esc(r.state)}</span>
        <span class="jamwhy">${r.assumed ? "at least " : ""}${ago(r.held)} with nothing landed</span>
      </div>
      <div class="jamlast">last commit ${ago(Date.now()/1000 - r.last_ts)} ago
        &middot; ${esc(r.last_sha)} ${esc(r.last_text)}</div>
      <span class="jamsrc">${esc(r.src)}${r.assumed
        ? " - first seen already in this state, so the real duration may be longer" : ""}</span>
      <div><button class="mini" onclick='post("/api/focus",{handle:${js(r.handle)}}, this)'
        >open the pane</button></div>
      ${ackBar(s, r.key)}
    </div>`).join("");
}

/* An IN-FLIGHT row whose lane has no live pane. Not tappable: there is no
   pane to focus and no safe edit to offer - the fix is a human closing the
   row, and a button that pretended otherwise would be lying about what it
   does. */
function renderOrphans(s){
  const shown = s.orphans || [], total = s.orphan_total || 0;
  const live = unhandled(s, shown), ackedN = shown.length - live.length;
  const rows = live.concat(shown.filter(r => ackOf(s, r.key)));
  document.getElementById("orphcount").innerHTML = total === 0
    ? "none - every IN-FLIGHT row has a live lane"
    : (total - ackedN) + " unhandled of " + total
      + " row" + (total === 1 ? "" : "s") + " claimed by a lane that is not running"
      + (total > shown.length ? ", oldest " + shown.length + " shown" : "")
      + (ackedN ? ` &middot; ${ackedN} acked here` : "");
  document.getElementById("orphsrc").textContent = total === 0 ? "" :
    "~/zao-vault/handoffs/IN-FLIGHT.md, newest row per lane. A lane counts as "
    + "live when its name and a pane's repo or worktree name contain one "
    + "another on their alphanumerics - fuzzy on purpose, because fractal "
    + "runs in ZAOfractal. Rows that say the lane closed are excluded.";
  document.getElementById("orphans").innerHTML = rows.map(r => `
    <div class="jam orph${ackOf(s, r.key) ? " acked" : ""}">
      <div class="jamline">
        <span class="who">${esc(r.lane)}</span>
        <span class="orphage">${r.age_days === null
          ? "date unreadable - shown anyway"
          : r.age_days + "d since it was claimed"}</span>
      </div>
      <div class="jamlast">${esc(r.doing)}</div>
      <span class="jamsrc">${esc(r.src)}</span>
      ${ackBar(s, r.key)}
    </div>`).join("");
}

/* Trend against the reading from before your last look.

   Four outcomes and they are not collapsed: no baseline at all (first look
   on this browser), no reading old enough to compare against, an equal
   reading (no change), or a real delta. A single reading never produces a
   direction - if nothing was observed at or before the last-look mark there
   is no arrow, because one number is a value, not a trend. */
const TREND_META = {
  lanes_waiting: { cell: "lanes",          of: "waiting",   goodUp: false },
  ahead_total:   { cell: "not on main",    of: "off main",  goodUp: false },
  unlanded_days: { cell: "oldest unlanded", of: "days stranded", goodUp: false },
  tasks_done:    { cell: "tasks",          of: "done",      goodUp: true  },
  ctx_critical:  { cell: "ctx critical",   of: "ctx-critical", goodUp: false },
  estate_risk:   { cell: "estate at risk", of: "at risk",   goodUp: false },
  drafts_queued: { cell: "oldest draft",   of: "queued",    goodUp: false },
};

function baselineFor(hist, key, mark){
  if (!mark) return { why: "no baseline yet - first look here" };
  const usable = (hist || []).filter(h =>
    h && h.ts <= mark && h.v && h.v[key] !== null && h.v[key] !== undefined);
  if (!usable.length) {
    return { why: (hist || []).length
      ? "no reading before your last look"
      : "no observations yet" };
  }
  return { sample: usable[usable.length - 1] };
}

function trendSpan(key, current, s){
  const meta = TREND_META[key];
  if (current === null || current === undefined) {
    return `<span class="trend"><span class="none">not measured this refresh</span></span>`;
  }
  const b = baselineFor(s.trend, key, seenAt());
  if (b.why) return `<span class="trend"><span class="none">${esc(b.why)}</span></span>`;
  const was = b.sample.v[key];
  const at = new Date(b.sample.ts * 1000).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"});
  if (was === current) {
    return `<span class="trend"><span class="none">${meta.of} unchanged since ${at}</span></span>`;
  }
  const d = current - was;
  const better = meta.goodUp ? d > 0 : d < 0;
  return `<span class="trend"><b class="${better ? "good" : "bad"}">` +
    `${d > 0 ? "+" : ""}${d}</b> ${esc(meta.of)} since ${at}</span>`;
}

/* How long the oldest queued draft has waited for a tap. "none queued" and
   "we could not read the queue" are different answers and stay different. */
function draftsCell(s){
  const d = s.drafts_age;
  if (!d || d.state === "unreadable") {
    return ["oldest draft", "~/.zao/orca-drafts.json unreadable",
            `<b class="bad">unknown</b>`, "drafts_queued"];
  }
  if (!d.count) {
    return ["oldest draft", "~/.zao/orca-drafts.json",
            `<b class="nil">none queued</b>`, "drafts_queued"];
  }
  const undated = d.undated
    ? ` &middot; <b class="bad">${d.undated}</b> undated` : "";
  if (!d.oldest) {
    return ["oldest draft", "~/.zao/orca-drafts.json",
            `<b class="bad">age unknown</b> &middot; <b>${d.count}</b> queued`,
            "drafts_queued"];
  }
  const age = Date.now()/1000 - d.oldest;
  const cls = age > 21600 ? "bad" : age > 3600 ? "flag" : "good";
  return ["oldest draft", "~/.zao/orca-drafts.json",
          `<b class="${cls}">${ago(age)}</b> waiting &middot; ` +
          `<b>${d.count}</b> queued${undated}`, "drafts_queued"];
}

/* How long the oldest thing off main has been sitting there. `not on main`
   counts commits; 66 landed this morning and 3 stranded since July read the
   same there and do not read the same here. */
function unlandedCell(s){
  const e = s.estate;
  const src = "git log <base>..HEAD, last line";
  if (!e) {
    return ["oldest unlanded", "no worktree could be read",
            `<b class="bad">unknown</b>`, "unlanded_days"];
  }
  const unm = e.age_unmeasurable
    ? ` &middot; <b class="bad">${e.age_unmeasurable}</b> age unreadable` : "";
  if (!e.ahead_total) {
    return ["oldest unlanded", src, `<b class="nil">nothing off main</b>`,
            "unlanded_days"];
  }
  if (!e.oldest_unlanded) {
    return ["oldest unlanded", src,
            `<b class="bad">age unknown</b>${unm}`, "unlanded_days"];
  }
  // The headline age is the oldest thing NOT yet accounted for. Acking the
  // 58-day branch you parked on purpose promotes the next real one instead
  // of hiding the whole surface.
  const live = unhandled(s, e.ahead).filter(a => a.oldest);
  const pick = live.length ? live[0] : null;
  const acked = (e.ahead || []).length - unhandled(s, e.ahead).length;
  if (!pick) {
    return ["oldest unlanded", src,
      `<b class="nil">nothing unacked</b>` +
      (acked ? ` &middot; <b class="nil">${acked}</b> acked` : "") + unm,
      "unlanded_days"];
  }
  const age = Date.now()/1000 - pick.oldest;
  const cls = age > 14*86400 ? "bad" : age > 3*86400 ? "flag" : "good";
  const note = acked ? ` <span class="none">(oldest unacked)</span>` : "";
  return ["oldest unlanded", src,
          `<b class="${cls}">${ago(age)}</b> &middot; ${esc(pick.repo)}${note}${unm}`,
          "unlanded_days"];
}

/* Work that has not reached main. Different question from `unpushed`: a
   branch pushed to origin is zero unpushed and still ahead of main, which is
   exactly the lane that commits steadily onto something that never lands. */
function aheadCell(s){
  const e = s.estate;
  if (!e) {
    return ["not on main", "no worktree could be read",
            `<b class="bad">unknown</b>`, "ahead_total"];
  }
  const unm = e.ahead_unmeasurable
    ? ` &middot; <b class="bad">${e.ahead_unmeasurable}</b> no main found` : "";
  if (!e.ahead_total) {
    return ["not on main", `rev-list origin/HEAD..HEAD, ${e.checked} worktrees`,
            `<b class="nil">0</b> commits off main${unm}`, "ahead_total"];
  }
  const ackedN = (e.ahead || []).length - unhandled(s, e.ahead).length;
  return ["not on main", `rev-list origin/HEAD..HEAD, ${e.checked} worktrees`,
          `<b class="flag">${e.ahead_total}</b> commits across ` +
          `<b>${e.ahead_repos}</b> lane${e.ahead_repos === 1 ? "" : "s"}${unm}` +
          (ackedN ? ` &middot; <b class="nil">${ackedN}</b> acked` : ""),
          "ahead_total"];
}

/* Work at risk across the live worktrees. Never a reassuring zero when the
   measurement failed - `unknown` is a real answer and a guessed 0 is not. */
function estateCell(s){
  const e = s.estate;
  if (!e) {
    return ["estate at risk", "no worktree could be read",
            `<b class="bad">unknown</b>`, "estate_risk"];
  }
  const bit = (n, label, cls) =>
    `<b class="${n ? cls : "nil"}">${n}</b> ${label}`;
  const v = [bit(e.dirty, "dirty", "bad"),
             bit(e.unpushed, "unpushed", "flag"),
             bit(e.noremote, "no remote", "bad")]
            .join(" &middot; ")
            + (e.unmeasured ? ` &middot; <b class="bad">${e.unmeasured}</b> unreadable` : "");
  return ["estate at risk", `git status, ${e.checked} live worktrees`, v,
          "estate_risk"];
}

/* The fleet, four numbers wide. A zero that should be zero renders dim; a
   number that means something is wrong renders warn or gold, so the strip
   is scannable without reading it. */
function strip(s){
  const P = s.panes || [], T = s.tasks || [];
  const n = r => P.filter(p => p.rank === r).length;
  const st = x => T.filter(t => t.status === x).length;
  const critical = n(0), idle = n(5), blocked = st("blocked") + st("failed");
  const stuckAll = s.stuck || [];
  const stuck = unhandled(s, stuckAll).length;
  const stuckAcked = stuckAll.length - stuck;
  const e0 = s.estate, d0 = s.drafts_age;
  const trendNow = {
    lanes_waiting: P.length ? n(3) : null,
    tasks_done: T.length ? st("completed") : null,
    ctx_critical: P.length ? n(0) : null,
    estate_risk: e0 ? e0.dirty + e0.unpushed + e0.noremote : null,
    drafts_queued: (d0 && d0.count !== null && d0.count !== undefined) ? d0.count : null,
  };
  let wcls = "good", wtxt = "-";
  if (!s.watcher_alive) { wcls = "bad"; wtxt = "DOWN"; }
  else if (!s.watcher_ts) { wcls = "flag"; wtxt = "no log yet"; }
  else {
    const w = Date.now()/1000 - s.watcher_ts;
    wtxt = ago(w) + " ago";
    wcls = w > 300 ? "flag" : "good";
  }
  const cells = [
    ["lanes", stuck ? "orca-board + zorca-claims.json" : "orca-board --json",
      `<b>${n(4)}</b> working &middot; <b>${n(3)}</b> waiting &middot; ` +
      `<b class="${idle ? "flag" : "nil"}">${idle}</b> idle &middot; ` +
      `<b class="nil">${n(6)}</b> free` +
      (stuck ? ` &middot; <b class="bad">${stuck}</b> STUCK` : "") +
      (stuckAcked ? ` &middot; <b class="nil">${stuckAcked}</b> acked` : ""),
      "lanes_waiting"],
    ["tasks", "orchestration.db", `<b class="good">${st("completed")}</b> done &middot; ` +
