.card[onclick] { border-color:var(--line-interactive); cursor:pointer; }
.card[onclick]:hover { background:var(--panel-raised); }
.gate { border-left:3px solid var(--gold); }
.gate.held { border-left-color:var(--warn); }
.dtext { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical;
         overflow:hidden; cursor:pointer; }
.dtext.open { display:block; -webkit-line-clamp:none; }
.dmore { color:var(--dim); font-size:12px; cursor:pointer; margin-bottom:8px;
         display:inline-block; }
.dmore:hover { color:var(--gold); }
button, .gate input[type=text] {
  font:inherit; margin:3px 6px 3px 0; padding:6px 12px; border-radius:7px;
  border:1px solid var(--line-interactive); background:var(--navy);
  color:var(--text); cursor:pointer; min-height:34px; }
button:hover { border-color:var(--gold); color:var(--gold); }
button[disabled] { opacity:.55; cursor:default; }
button.mini { color:var(--gold); padding:2px 10px; min-height:0; }
input[type=text] { width:58%; cursor:text; }

/* rail 2 - the wall */
.pane { display:flex; gap:12px; align-items:baseline; padding:9px 14px; }
.pane:hover .repo { color:var(--gold); }
.repo { min-width:170px; font-weight:600; }
.chip { display:inline-block; min-width:118px; padding:1px 8px;
        border-radius:5px; border-left:3px solid var(--line);
        background:transparent; font-size:13px; color:var(--dim); }
.r0 { border-left-color:var(--warn); color:var(--warn); }
.r1, .r2 { border-left-color:var(--gold); color:var(--gold); }
.r3, .r4 { border-left-color:var(--ok); color:var(--ok); }
.r5 { border-left-color:var(--gold); color:var(--gold); }
.r6 { border-left-color:var(--line-interactive); color:var(--dim); }
.ctx { min-width:104px; color:var(--dim); font-size:13px; }
.ctx.hot { color:var(--warn); }
.detail { color:var(--dim); font-size:13px; overflow:hidden;
          text-overflow:ellipsis; white-space:nowrap; }
#wallsummary { font-size:13px; letter-spacing:0; text-transform:none; }
#wallsummary .idle { color:var(--gold); }

/* what is stuck - a lane claiming to work with nothing landed */
#stuck { margin-top:26px; }
#stuck h2 { color:var(--warn); }
#stuck.clear h2 { color:var(--dim); }
.jam { background:var(--panel); border:1px solid var(--line-interactive);
       border-left:3px solid var(--warn); border-radius:var(--r);
       padding:11px 14px; margin-bottom:9px; cursor:pointer; }
.jam:hover { background:var(--panel-raised); }
.jamline { display:flex; gap:10px; align-items:baseline; flex-wrap:wrap; }
.jamwhy { color:var(--warn); font-size:13px; }
.jamlast { color:var(--dim); font-size:13px; margin-top:5px;
           display:-webkit-box; -webkit-line-clamp:2;
           -webkit-box-orient:vertical; overflow:hidden; }
.jamsrc { display:block; font-size:10px; color:var(--dim); opacity:.75;
          margin-top:5px; line-height:1.3; }
h3 { font-size:12px; text-transform:uppercase; letter-spacing:.14em;
     color:var(--dim); font-weight:400; margin:20px 0 9px; }
.orph { border-left-color:var(--gold); cursor:default; }
.orph:hover { background:var(--panel); }
.orphage { color:var(--gold); font-size:13px; }

/* rail 3 - reference, folded away */
#ref { margin-top:30px; border-top:1px solid var(--line); padding-top:8px; }
#ref summary { color:var(--dim); font-size:13px; cursor:pointer;
               padding:8px 0; }
#ref summary:hover { color:var(--gold); }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:26px; }
@media (max-width:980px){ .grid{grid-template-columns:1fr} }
.task { display:flex; gap:12px; padding:3px 0; }
.task .st { min-width:100px; }
.st-completed{color:var(--ok)} .st-ready{color:var(--gold)}
.st-blocked{color:var(--warn)} .st-dispatched{color:var(--info)}
.st-pending{color:var(--dim)}
.stamp { color:var(--dim); font-size:12px; }
@media (max-width:720px){
  body { font-size:14px; padding:14px; }
  header { margin-left:-11px; gap:10px; }
  h1 { font-size:17px; }
  /* the run string lives in the fold on a phone - see #runref */
  h1 small { display:none; }
  #needsyou { margin-left:-15px; padding-left:12px; }
  /* two lines: repo + chip, then ctx + detail. Nothing may push the page
     sideways at 390px. */
  .pane { flex-wrap:wrap; gap:6px 10px; min-height:38px; }
  .repo, .chip, .ctx, .state { min-width:auto; }
  .repo { flex:1 1 auto; }
  .chip { flex:0 0 auto; }
  .ctx { flex:0 0 auto; }
  .detail { flex:1 1 100%; min-width:0; }
  button, input[type=text] { min-height:38px; }
  /* the parked-lane button opts out of min-height on desktop; on a phone
     it is still a tap target */
  button.mini { min-height:38px; }
  input[type=text] { width:100%; }
  /* A rank<=2 lane is already a card in rail 1, directly above. On a phone
     the wall's copy of it is a whole card of scroll for nothing, so the
     wall drops the duplicate. On desktop both stay, so the wall reads as a
     complete picture of what is running. */
  #panes .pane.dup { display:none; }
  #strip { grid-template-columns:1fr 1fr; }
  #sincecount { display:block; margin-top:2px; }
  #needbtn { font-size:17px; }
  .actline { gap:8px; }
  .age { margin-left:0; }
  .task { flex-wrap:wrap; }
  .task .st { min-width:auto; }
  .grid { gap:14px; }
}
#toast { position:fixed; bottom:22px; right:22px; background:var(--gold);
         color:var(--navy); padding:10px 16px; border-radius:8px;
         font-weight:700; display:none; z-index:9; }
#toast.bad { background:var(--warn); color:var(--navy); }
</style></head><body>
<header id="head">
 <h1>ZORCA <small id="run"></small></h1>
 <div id="freshness"></div>
</header>

<div id="topbar">
 <button id="needbtn" onclick='document.getElementById("needsyou")
   .scrollIntoView({behavior:"smooth", block:"start"})'>
   <span id="needcount">-</span><span class="sub" id="needsub"></span></button>
 <div id="strip"></div>
</div>

<section id="since">
 <h2>Since you last looked <span class="stamp" id="sincecount"></span></h2>
 <div id="feed"></div>
</section>

<section id="needsyou">
 <h2>Do these in order</h2>
 <div id="actions"></div>
</section>

<section id="wall">
 <h2>The wall <span class="stamp" id="wallsummary"></span></h2>
 <div id="panes"></div>
</section>

<section id="stuck">
 <h2>Stuck <span class="stamp" id="stuckcount"></span></h2>
 <div id="jams"></div>
 <h3>Claims outliving their lane <span class="stamp" id="orphcount"></span></h3>
 <div class="jamsrc" id="orphsrc" style="margin:-4px 0 9px"></div>
 <div id="orphans"></div>
</section>

<details id="ref">
 <summary>Tasks, resolved gates, parked lanes, watcher trail</summary>
 <div class="stamp" id="runref"></div>
 <div class="grid">
  <div><h2>Tasks</h2><div class="card" id="tasks"></div></div>
  <div>
   <h2>Recently resolved</h2><div class="card" id="resolved"></div>
   <h2>Parked lanes - tap to reopen</h2><div class="card" id="lanes"></div>
   <h2>Watcher trail</h2>
   <div class="card" id="wlog" style="font-size:12px;color:var(--dim);
     max-height:220px;overflow-y:auto"></div>
   <h2>Free and finished</h2><div class="card" id="coldpanes"></div>
  </div>
 </div>
</details>
<div id="toast" role="status" aria-live="polite"></div>
<script>
const INFLIGHT = new Set();
async function post(url, body, el){
  const key = url + "|" + (body.id || body.handle || body.i);
  if (INFLIGHT.has(key)) return;
  INFLIGHT.add(key);
  if (el) { el.disabled = true; el.dataset.was = el.textContent; el.textContent = "..."; }
  let ok = false, why = "";
  try {
    const r = await fetch(url, {method:"POST", body: JSON.stringify(body)});
    ok = r.ok;
    if (!ok) why = " (" + r.status + ")";
  } catch (e) {
    why = " (no server)";
  }
  toast(ok ? "done" : "failed" + why, ok);
  INFLIGHT.delete(key);
  if (el && el.dataset.was) { el.disabled = false; el.textContent = el.dataset.was; }
  load();
}
function toast(msg, ok){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.className = ok ? "" : "bad";
  t.style.display = "block";
  setTimeout(()=>t.style.display="none", ok ? 1800 : 4000);
}
function esc(s){ const d=document.createElement("div"); d.textContent=s||""; return d.innerHTML; }

/* ZORCA already holds danger-worded drafts on rail 1. The GUI was the one
   surface where that hold was invisible - this only renders it. No override
   is added: a held draft is still sendable, it just costs a second tap. */
const DANGER = /license|publish|delete|archive|push|merge|rotate|credential/i;
function danger(reason){
  const m = DANGER.exec(reason || "");
  return m ? m[0].toLowerCase() : "";
}
/* The "last look" mark. Read once per page load: the value in storage is
   the PREVIOUS visit, and now is stamped over it immediately, so polling
   every 15s does not erase the marker mid-session. Storage can throw
   (private window, blocked site data) - a feed with no NEW marks is still a
   feed, so every access is guarded and failure is silent by design. */
let SEEN = null;
function seenAt(){
  if (SEEN !== null) return SEEN;
  let prev = 0;
  try { prev = Number(localStorage.getItem("zorca.seen")) || 0; } catch (e) {}
  try { localStorage.setItem("zorca.seen", String(Math.floor(Date.now()/1000))); } catch (e) {}
  SEEN = prev;
  return SEEN;
}

/* One feed out of two sources, newest first. An event whose time would not
   parse server-side arrives with ts 0: it is never called new, and it is
   never dropped - a "what happened" surface that hides an event it could
   not date is worse than one that admits it (parse, do not sort - a979b96). */
function feed(s){
  const rows = [];
  (s.daily || []).forEach(d => rows.push({
    ts: d.ts, tag: "vault", kind: "vault",
    text: d.detail ? d.text + " - " + d.detail : d.text, src: d.src }));
  (s.gitlog || []).forEach(g => rows.push({
    ts: g.ts, tag: "git", kind: "git",
    text: g.repo + " " + g.sha + " " + g.text, src: g.src }));
  rows.sort((a, b) => (b.ts || 0) - (a.ts || 0));
  return rows;
}

function renderFeed(s){
  const all = feed(s), mark = seenAt();
  const fresh = all.filter(r => r.ts && r.ts > mark).length;
  document.getElementById("sincecount").textContent =
    mark === 0 ? "first look on this browser - showing the latest"
    : fresh === 0 ? "nothing new since " + new Date(mark*1000).toLocaleTimeString()
    : fresh + " new since " + new Date(mark*1000).toLocaleTimeString();
  // Three on a phone, not four. The stat cells grew when every one of them
  // started naming its source, and the action list must stay above the fold
  // (milestone 4). The feed is context; the decisions are the point.
  const show = all.slice(0, window.innerWidth <= 720 ? 3 : 6);
  document.getElementById("feed").innerHTML = show.map(r => {
    const isNew = r.ts && r.ts > mark;
    const when = r.ts ? new Date(r.ts*1000).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"})
                      : "??:??";
    return `<div class="ev ${r.kind}${isNew ? " new" : ""}">
      <span class="evtime">${when}</span>
      <span class="evtag">${r.tag}</span>
      ${isNew ? '<span class="evnew">NEW</span>' : ""}
      <span class="evtext">${esc(r.text)}</span>
      <span class="evsrc">${esc(r.ts ? r.src : r.src + " (time unreadable - shown anyway)")}</span>
    </div>`;
  }).join("") || '<div class="card">no events today - ' +
    'vault daily log and worktree commits are both empty</div>';
  if (all.length > show.length) {
    document.getElementById("feed").innerHTML +=
      `<div class="stamp">${all.length - show.length} older not shown</div>`;
  }
}

/* Gate timestamps arrive as "YYYY-MM-DD HH:MM[:SS]"; anything else is
   treated as unknown age rather than guessed at. */
function parseTs(v){
  if (!v) return 0;
  const t = Date.parse(String(v).replace(" ", "T"));
  return isNaN(t) ? 0 : t / 1000;
}

/* One queue out of three sources. Order is irreversibility first, then
   oldest - a send that cannot be taken back outranks a lane that is merely
   blocked, and an unknown age sorts last rather than pretending to be new. */
function actions(s){
  const out = [];
  (s.drafts || []).forEach(d => {
    const hit = danger((d.reason || "") + " " + (d.text || ""));
    out.push({
      tier: hit ? 0 : 3,
      tag: hit ? "IRREVERSIBLE" : "SEND",
      who: d.repo,
      why: hit ? "danger word: " + hit : (d.reason || "queued draft"),
      ts: d.ts || 0,
      text: d.text || "",
      buttons: `<button onclick='sendDraft("${d.id}", this, ${hit ? "true" : "false"})'>Send</button>
        <button onclick='post("/api/draft",{id:"${d.id}",action:"skip"}, this)'>Skip</button>`
    });
  });
  (s.panes || []).filter(p => p.rank === 0).forEach(p => {
    out.push({
      tier: 1, tag: "CONTEXT", who: p.repo,
      why: p.ctx == null ? "context critical" : p.ctx + "% - hand off now",
      ts: 0, text: p.question || p.tail || "",
      buttons: `<button onclick='post("/api/focus",{handle:"${p.handle}"}, this)'>open the pane</button>`
    });
  });
  (s.gates || []).forEach(g => {
    const opts = (g.options || []).map(o =>
      `<button onclick='post("/api/resolve",{id:"${g.id}",resolution:${JSON.stringify(o)}}, this)'>${esc(o)}</button>`).join("");
    const close = (g.options || []).length === 0
      ? `<button onclick='post("/api/resolve",{id:"${g.id}",resolution:"Closed by Zaal from ZORCA GUI: addressed, no further action."}, this)'>close - addressed</button>`
      : "";
    out.push({
      tier: 2, tag: "BLOCKED", who: "decision gate",
      why: "a lane is waiting on your call",
      ts: parseTs(g.created_at), text: g.question || "",
      buttons: opts + close +
        `<input type="text" id="in-${g.id}" placeholder="or type an answer">
         <button onclick='post("/api/resolve",{id:"${g.id}",
           resolution:document.getElementById("in-${g.id}").value}, this)'>send</button>`
    });
  });
  (s.panes || []).filter(p => p.rank === 1 || p.rank === 2).forEach(p => {
    out.push({
      tier: 4, tag: "ASKED", who: p.repo, why: esc(p.state),
      ts: 0, text: p.question || p.tail || "",
      buttons: `<button onclick='post("/api/focus",{handle:"${p.handle}"}, this)'>open the pane</button>`
    });
  });
  const LAST = 1e18;
  out.sort((a, b) => (a.tier - b.tier) || ((a.ts || LAST) - (b.ts || LAST)));
  return out;
}

function actRow(a){
  const age = a.ts ? ago(Date.now()/1000 - a.ts) + " old" : "";
  return `<div class="act t${a.tier}">
    <div class="actline">
      <span class="tier">${a.tag}</span>
      <span class="who">${esc(a.who)}</span>
      <span class="why">${a.why}</span>
      <span class="age">${age}</span>
    </div>
    <div class="detail dtext" style="white-space:normal"
      onclick='expand(this)'>${esc(a.text)}</div>
    <span class="dmore" onclick='expand(this.previousElementSibling, this)'
      >show all &darr;</span>
    <div class="acts">${a.buttons}</div>
  </div>`;
}

/* A lane claiming to work with nothing landed since the claim began.
   "held" is measured by zorca watching the state change, so a pane first
   seen already working reports "at least" - a duration we did not observe
   is never reported as one we did. */
function renderStuck(s){
  const rows = s.stuck || [];
  document.getElementById("stuckcount").textContent = rows.length === 0
    ? "nothing stuck - every working lane has landed something since it started"
    : rows.length + " claiming to work with nothing landed";
  document.getElementById("stuck").classList.toggle("clear", rows.length === 0);
  document.getElementById("jams").innerHTML = rows.map(r => `
    <div class="jam" onclick='post("/api/focus",{handle:"${r.handle}"}, this)'>
      <div class="jamline">
        <span class="who">${esc(r.repo)}</span>
        <span class="chip r${r.state === "working" ? 4 : 3}">${esc(r.state)}</span>
        <span class="jamwhy">${r.assumed ? "at least " : ""}${ago(r.held)} with nothing landed</span>
      </div>
      <div class="jamlast">last commit ${ago(Date.now()/1000 - r.last_ts)} ago
        &middot; ${esc(r.last_sha)} ${esc(r.last_text)}</div>
      <span class="jamsrc">${esc(r.src)}${r.assumed
        ? " - first seen already in this state, so the real duration may be longer" : ""}</span>
    </div>`).join("");
}

/* An IN-FLIGHT row whose lane has no live pane. Not tappable: there is no
   pane to focus and no safe edit to offer - the fix is a human closing the
   row, and a button that pretended otherwise would be lying about what it
   does. */
function renderOrphans(s){
  const rows = s.orphans || [], total = s.orphan_total || 0;
  document.getElementById("orphcount").textContent = total === 0
    ? "none - every IN-FLIGHT row has a live lane"
    : total + " row" + (total === 1 ? "" : "s") + " claimed by a lane that is not running"
      + (total > rows.length ? ", oldest " + rows.length + " shown" : "");
  document.getElementById("orphsrc").textContent = total === 0 ? "" :
    "~/zao-vault/handoffs/IN-FLIGHT.md, newest row per lane. A lane counts as "
    + "live when its name and a pane's repo or worktree name contain one "
    + "another on their alphanumerics - fuzzy on purpose, because fractal "
    + "runs in ZAOfractal. Rows that say the lane closed are excluded.";
  document.getElementById("orphans").innerHTML = rows.map(r => `
    <div class="jam orph">
      <div class="jamline">
        <span class="who">${esc(r.lane)}</span>
        <span class="orphage">${r.age_days === null
          ? "date unreadable - shown anyway"
          : r.age_days + "d since it was claimed"}</span>
      </div>
      <div class="jamlast">${esc(r.doing)}</div>
      <span class="jamsrc">${esc(r.src)}</span>
    </div>`).join("");
}

/* The fleet, four numbers wide. A zero that should be zero renders dim; a
   number that means something is wrong renders warn or gold, so the strip
   is scannable without reading it. */
function strip(s){
  const P = s.panes || [], T = s.tasks || [];
  const n = r => P.filter(p => p.rank === r).length;
  const st = x => T.filter(t => t.status === x).length;
  const critical = n(0), idle = n(5), blocked = st("blocked") + st("failed");
  const stuck = (s.stuck || []).length;
  let wcls = "good", wtxt = "-";
  if (!s.watcher_alive) { wcls = "bad"; wtxt = "DOWN"; }
  else if (!s.watcher_ts) { wcls = "flag"; wtxt = "no log yet"; }
  else {
    const w = Date.now()/1000 - s.watcher_ts;
    wtxt = ago(w) + " ago";
    wcls = w > 300 ? "flag" : "good";
  }
  const cells = [
    ["lanes", stuck
        ? "orca-board --json; stuck = git log -1 vs ~/.zao/zorca-claims.json"
        : "orca-board --json",
      `<b>${n(4)}</b> working &middot; <b>${n(3)}</b> waiting &middot; ` +
      `<b class="${idle ? "flag" : "nil"}">${idle}</b> idle &middot; ` +
      `<b class="nil">${n(6)}</b> free` +
      (stuck ? ` &middot; <b class="bad">${stuck}</b> STUCK` : "")],
    ["tasks", "orchestration.db (read-only)", `<b class="good">${st("completed")}</b> done &middot; ` +
      `<b class="flag">${st("ready")}</b> ready &middot; ` +
      `<b class="${blocked ? "bad" : "nil"}">${blocked}</b> blocked`],
    ["ctx critical", "orca-board --json, rank 0", `<b class="${critical ? "bad" : "nil"}">${critical}</b>` +
      (critical ? " needs a handoff" : " - none near full")],
    ["watcher", "~/.zao/orca-board.log + pgrep", `<b class="${wcls}">${wtxt}</b>`]
  ];
  document.getElementById("strip").innerHTML = cells.map(([k, src, v]) =>
    `<div class="cell"><span class="k">${k}</span><span class="v">${v}</span>` +
    `<span class="src">${esc(src)}</span></div>`).join("");
}

/* Only offer "show all" where there is more to show. */
function trimToggles(){
  document.querySelectorAll(".dtext").forEach(b => {
    const more = b.nextElementSibling;
    if (!more || !more.classList.contains("dmore")) return;
    more.style.display = b.classList.contains("open")
      || b.scrollHeight > b.clientHeight + 1 ? "inline-block" : "none";
  });
}

function expand(box, tag){
  const open = box.classList.toggle("open");
  const t = tag || box.nextElementSibling;
  if (t && t.classList.contains("dmore")) t.innerHTML = open ? "show less \u2191" : "show all \u2193";
}
function sendDraft(id, el, held){
  if (held && el.dataset.armed !== "1") {
    el.dataset.armed = "1";
    el.textContent = "confirm send";
    setTimeout(()=>{ if (el.dataset.armed === "1") {
      el.dataset.armed = ""; el.textContent = "Send"; } }, 6000);
    return;
  }
  post("/api/draft", {id: id, action: "send"}, el);
}
function ago(sec){
  if (sec < 90) return Math.round(sec) + "s";
  if (sec < 5400) return Math.round(sec/60) + "m";
  return (sec/3600).toFixed(1) + "h";
}
function freshness(s){
  const at = new Date(s.ts*1000).toLocaleTimeString();
  const age = Date.now()/1000 - s.ts;
  let cls = "fresh", txt = "live";
  if (age >= 45) { cls = "aging"; txt = "as of " + at; }
  if (age > 90) { cls = "stale"; txt = "STALE " + ago(age) + " - refresher may be dead"; }
  if (s.err) { cls = "stale"; txt = "STALE - " + s.err; }
  document.getElementById("freshness").innerHTML =
    `<span class="${cls}">${esc(txt)}</span>` +
    (cls === "fresh" ? `<span class="at">${esc(at)}</span>` : "");
  document.getElementById("head").classList.toggle("warn", cls === "stale");
}

/* A pane row. The state string is always rendered as text - the chip colour
   is the redundant channel, never the only one. */
function paneRow(p, dup){
  const hot = p.ctx != null && p.ctx >= 85;
  const ctx = p.ctx == null ? "-"
            : (hot ? p.ctx + "% - hand off" : p.ctx + "%");
  return `<div class="card pane${dup ? " dup" : ""}" onclick='post("/api/focus",{handle:"${p.handle}"}, this)'>
      <span class="repo">${esc(p.repo)}</span>
      <span class="chip r${p.rank}">${esc(p.state)}</span>
      <span class="ctx${hot ? " hot" : ""}">${ctx}</span>
      <span class="detail">${esc(p.question || p.tail || "")}</span>
    </div>`;
}

async function load(){
