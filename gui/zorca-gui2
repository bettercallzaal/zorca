def queue_drop(did):
    items = [i for i in queue_read() if i.get("id") != did]
    json.dump(items, open(QUEUE, "w"), indent=1)


# A value that starts with a dash is parsed as a FLAG in the space form:
# `--resolution "--json"` makes orca answer "Missing required --resolution"
# and drop into non-JSON output, and a craftier value could set a different
# flag entirely. The `=` form binds the value to its own flag, verified
# against the real CLI. Every user-supplied value goes through this.
def flag(name, value):
    return "--%s=%s" % (name, value)


# Handles, gate ids and draft ids are opaque tokens, not free text. Anything
# outside this set is refused rather than passed along - it cannot be a real
# id, so the only thing it can be is an attempt.
TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")


def is_token(v):
    return bool(v) and isinstance(v, str) and bool(TOKEN_RE.match(v))


def sh(args, timeout=60, strict=False):
    """Run a command and return stdout.

    strict=True is the refresh path: a missing binary or a timeout is a
    real failure and must reach the header, not become an empty string.
    SPEC 2 asks the board to fail loud, and it cannot if every read swallows
    its own exception. Tap handlers stay strict=False - a failed tap already
    reports itself through the toast.
    """
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        if strict:
            raise
        return ""
    except Exception:
        if strict:
            raise
        return ""


def orca_json(*args):
    out = sh([ORCA] + list(args) + ["--json"], strict=True)
    try:
        return json.loads(out).get("result", {})
    except Exception:
        return {}


ODB = os.path.expanduser(
    "~/Library/Application Support/orca/orchestration.db")


def load_tasks(run_id):
    """Straight from the orchestration DB, read-only - specs included.

    file: URI with mode=ro so we can never write, and a busy_timeout so a
    daemon write never wedges the refresh.
    """
    import sqlite3
    rows = []
    try:
        con = sqlite3.connect("file:%s?mode=ro" % ODB, uri=True, timeout=3)
        cur = con.execute(
            "SELECT id, status, task_title, spec, created_at FROM tasks "
            "ORDER BY created_at")
        for tid, status, title, spec, upd in cur.fetchall():
            rows.append(dict(id=tid, status=status, title=title or "?",
                             spec=spec or "", updated=upd or ""))
        con.close()
    except Exception:
        # Fall back to the CLI text parse if the schema shifts.
        for ln in sh([ORCA, "orchestration", "task-list", "--run",
                      run_id]).splitlines():
            ln = ln.strip()
            if ln.startswith("task_"):
                parts = ln.split()
                rows.append(dict(id=parts[0],
                                 status=parts[1].strip("[]") if len(parts) > 1 else "?",
                                 title=parts[2] if len(parts) > 2 else "?",
                                 spec="", updated=""))
    return rows


