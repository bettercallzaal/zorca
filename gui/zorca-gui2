  document.getElementById("run").textContent = s.run;
  document.getElementById("runref").textContent = s.run;
  freshness(s);

  /* --- the top bar: the whole answer to "what do I need to do" ------ */
  const acts = actions(s);
  const need = acts.length;
  const urgent = acts.filter(a => a.tier <= 1).length;
  document.getElementById("needcount").textContent =
    need === 0 ? "0 NEED YOU" : need + " NEED YOU";
  document.getElementById("needsub").textContent = need === 0
    ? "the wall is working - nothing is waiting on you"
    : urgent + " irreversible or losing context, " + (need - urgent) + " the rest"
      + " - tap to jump";
  document.getElementById("needbtn").classList.toggle("clear", need === 0);
  document.getElementById("needsyou").classList.toggle("clear", need === 0);
  strip(s);
  renderFeed(s);
  document.getElementById("actions").innerHTML = acts.map(actRow).join("")
    || '<div class="card">nothing needs you</div>';
  trimToggles();

  /* --- rail 2: the wall. Free and finished lanes collapse into the
         summary; a card here means a lane that is actually running. --- */
  const live = s.panes.filter(p => p.rank <= 4);
  const working = s.panes.filter(p => p.rank == 3 || p.rank == 4).length;
  const free = s.panes.filter(p => p.rank == 6).length;
  const idle = s.panes.filter(p => p.rank == 5).length;
  document.getElementById("wallsummary").innerHTML =
    `${working} working &middot; ${free} free &middot; ` +
    `<span class="${idle ? "idle" : ""}">${idle} idle</span>`;
  document.getElementById("panes").innerHTML =
    live.map(p => paneRow(p, p.rank <= 2)).join("")
    || '<div class="card">no live panes</div>';
  renderStuck(s);
  renderOrphans(s);
  document.getElementById("coldpanes").innerHTML =
    s.panes.filter(p => p.rank >= 5).map(paneRow).join("")
    || '<span class="stamp">none</span>';

  /* --- rail 3: reference ------------------------------------------- */
  document.getElementById("tasks").innerHTML = s.tasks.map((t,i) => `
    <div class="task" style="cursor:pointer" onclick='
      const el=document.getElementById("spec-"+${i});
      el.style.display = el.style.display=="none" ? "block" : "none";'>
      <span class="st st-${t.status}">${t.status}</span>
      <span>${esc(t.title)}</span></div>
    <div id="spec-${i}" style="display:none" class="detail"
      ><div style="white-space:normal;padding:4px 0 10px 112px">
      ${esc(t.spec)}<br><span class="stamp">${t.id} &middot; ${esc(t.updated)}</span>
      </div></div>`).join("");
  document.getElementById("resolved").innerHTML = s.resolved.map(g => `
    <div class="task"><span class="st st-completed">resolved</span>
      <span>${esc(g.question.slice(0,70))} &rarr; <b>${esc(g.resolution||"")}</b></span>
    </div>`).join("") || '<span class="stamp">none yet</span>';
  document.getElementById("lanes").innerHTML = s.lanes.map((l,i) => `
    <div class="task"><button class="mini"
      onclick='post("/api/lane",{i:${i}}, this)'>open</button>
      <span>${esc(l.name)}</span>
      <span class="stamp">${esc(l.worktree.replace(/^.*zaalpanthaki/,"~"))}</span>
    </div>`).join("") || '<span class="stamp">no parked lanes</span>';
  document.getElementById("wlog").innerHTML = s.log.map(l => {
    // The two-character prefix is the real signal; colour is the echo.
    let c = "var(--dim)", tag = "..";
    if (l.includes(" SENT ")) { c = "var(--ok)"; tag = ">>"; }
    if (l.includes(" HOLD ") || l.includes("QUEUE")) { c = "var(--gold)"; tag = "!!"; }
    if (l.includes("DROPPED") || l.includes("failed")) { c = "var(--warn)"; tag = "xx"; }
    return `<div style="color:${c}">${tag} ${esc(l)}</div>`;
  }).join("") || '<span class="stamp">watcher not running</span>';
}
/* Focus, never activate. 1-9 lands you on the nth control of the first
   action row; Enter does the rest natively, so a stray keystroke can never
   resolve a gate or send a draft. */
document.addEventListener("keydown", e => {
  const a = document.activeElement;
  if (a && (a.tagName === "INPUT" || a.tagName === "TEXTAREA" || a.isContentEditable)) return;
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  if (e.key === "?") {
    const r = document.getElementById("ref");
    r.open = !r.open;
    e.preventDefault();
    return;
  }
  if (e.key >= "1" && e.key <= "9") {
    const row = document.querySelector("#actions .act");
    if (!row) return;
    const btn = row.querySelectorAll("button")[Number(e.key) - 1];
    if (btn) { btn.focus(); e.preventDefault(); }
  }
});
load(); setInterval(load, 15000);
</script></body></html>"""


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif self.path == "/api/state":
            with LOCK:
                self._send(200, json.dumps(CACHE))
        else:
            self._send(404, "{}")

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n) or "{}")
        except Exception:
            body = {}
        if self.path == "/api/resolve" and body.get("id") and body.get("resolution"):
            # Belt to the client's braces: even if a second tap escapes the
            # in-flight guard, it must not shell out a second gate-resolve.
            with LOCK:
                if body["id"] in RESOLVED:
                    self._send(200, json.dumps({"ok": True, "dup": True}))
                    return
            out = sh([ORCA, "orchestration", "gate-resolve", "--id", body["id"],
                      "--resolution", body["resolution"], "--json"])
            ok = '"ok": true' in out or '"ok":true' in out
            if ok:
                with LOCK:
                    RESOLVED.add(body["id"])
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/focus" and body.get("handle"):
            sh([ORCA, "terminal", "switch", "--terminal", body["handle"]])
            self._send(200, '{"ok": true}')
        elif self.path == "/api/lane" and body.get("i") is not None:
            lanes = load_lanes()
            ok = False
            try:
                l = lanes[int(body["i"])]
                # Zaal's tap: open an Orca pane in the lane's worktree and
                # resume its Claude session. Spawns a paid session - which is
                # exactly what the button says it does.
                out = sh([ORCA, "terminal", "create", "--worktree",
                          "path:" + l["worktree"], "--title", l["name"],
                          "--command", l["cmd"], "--focus"], timeout=120)
                ok = "Created terminal" in out
            except Exception:
                pass
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/draft" and body.get("id"):
            item = next((i for i in queue_read() if i["id"] == body["id"]), None)
            ok = True
            if item and body.get("action") == "send":
                # The human tapped Send - this is Zaal's keystroke, so no
                # auto-draft prefix; it carries his authority.
                out = sh([ORCA, "terminal", "send", "--terminal",
                          item["handle"], "--text", item["text"], "--enter"])
                ok = "Sent" in out
            if item:
                queue_drop(body["id"])
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        else:
            self._send(400, '{"ok": false}')


def main():
    port = PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    threading.Thread(target=refresher, daemon=True).start()
    print("ZORCA GUI2 on http://127.0.0.1:%d  (ctrl-c to stop)" % port)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


if __name__ == "__main__":
    main()
