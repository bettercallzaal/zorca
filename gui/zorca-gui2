  const age = Date.now()/1000 - at;
  const stale = age > (s.ack_stale_s || 604800);
  return `<div class="ackline">acked <b class="${stale ? "stale" : ""}">${ago(age)} ago</b>` +
    (stale ? " - and still here" : "") +
    ` <button class="mini ack"
      onclick='post("/api/ack",{key:${k},action:"unack"}, this)'>unack</button></div>`;
}

function renderStuck(s){
  const all = (s.stuck || []).filter(r => hit(r.repo, r.state, r.last_text));
  const rows = unhandled(s, all), ackedN = all.length - rows.length;
  const ordered = rows.concat(all.filter(r => ackOf(s, r.key)));
  const cand = s.stuck_candidates || 0, obs = s.stuck_observed || 0;
  document.getElementById("stuckcount").innerHTML = rows.length === 0
    ? (ackedN ? `nothing unhandled - ${ackedN} acked`
       : cand === 0 ? "no lane is claiming to work"
       : obs === 0
         ? `nothing to report yet - none of the ${cand} working lane` +
           `${cand === 1 ? " has" : "s have"} been watched long enough to judge`
         : `nothing unhandled - all ${obs} lane${obs === 1 ? "" : "s"} watched ` +
           `long enough ${obs === 1 ? "has" : "have"} landed something`)
    : rows.length + " claiming to work with nothing landed"
      + (ackedN ? ` &middot; ${ackedN} acked` : "");
  document.getElementById("stuck").classList.toggle("clear", rows.length === 0);
  document.getElementById("jams").innerHTML = ordered.map(r => `
    <div class="jam${ackOf(s, r.key) ? " acked" : ""}">
      <div class="jamline">
        <span class="who">${esc(r.repo)}</span>
        <span class="chip r${r.state === "working" ? 4 : 3}">${esc(r.state)}</span>
        <span class="jamwhy">${r.assumed ? "at least " : ""}${ago(r.held)} with nothing landed</span>
      </div>
      <div class="jamlast">last commit ${ago(Date.now()/1000 - r.last_ts)} ago
        &middot; ${esc(r.last_sha)} ${esc(r.last_text)}</div>
      <span class="jamsrc">${esc(r.src)}${r.assumed
        ? " - first seen already in this state, so the real duration may be longer" : ""}</span>
      <div><button class="mini" onclick='post("/api/focus",{handle:${js(r.handle)}}, this)'
        >open the pane</button></div>
      ${ackBar(s, r.key)}
    </div>`).join("");
}

/* An IN-FLIGHT row whose lane has no live pane. Not tappable: there is no
   pane to focus and no safe edit to offer - the fix is a human closing the
   row, and a button that pretended otherwise would be lying about what it
   does. */
function renderOrphans(s){
  const shown = (s.orphans || []).filter(r => hit(r.lane, r.doing));
  const total = FILTER ? shown.length : (s.orphan_total || 0);
  const live = unhandled(s, shown), ackedN = shown.length - live.length;
  const rows = live.concat(shown.filter(r => ackOf(s, r.key)));
  document.getElementById("orphcount").innerHTML = total === 0
    ? "none - every IN-FLIGHT row has a live lane"
    : (total - ackedN) + " unhandled of " + total
      + " row" + (total === 1 ? "" : "s") + " claimed by a lane that is not running"
      + (total > shown.length ? ", oldest " + shown.length + " shown" : "")
      + (ackedN ? ` &middot; ${ackedN} acked here` : "");
  document.getElementById("orphsrc").textContent = total === 0 ? "" :
    "~/zao-vault/handoffs/IN-FLIGHT.md, newest row per lane. A lane counts as "
    + "live when its name and a pane's repo or worktree name contain one "
    + "another on their alphanumerics - fuzzy on purpose, because fractal "
    + "runs in ZAOfractal. Rows that say the lane closed are excluded.";
  document.getElementById("orphans").innerHTML = rows.map(r => `
    <div class="jam orph${ackOf(s, r.key) ? " acked" : ""}">
      <div class="jamline">
        <span class="who">${esc(r.lane)}</span>
        <span class="orphage">${r.age_days === null
          ? "date unreadable - shown anyway"
          : r.age_days + "d since it was claimed"}</span>
      </div>
      <div class="jamlast">${esc(r.doing)}</div>
      <span class="jamsrc">${esc(r.src)}</span>
      ${ackBar(s, r.key)}
    </div>`).join("");
}

/* Trend against the reading from before your last look.

   Four outcomes and they are not collapsed: no baseline at all (first look
   on this browser), no reading old enough to compare against, an equal
   reading (no change), or a real delta. A single reading never produces a
   direction - if nothing was observed at or before the last-look mark there
   is no arrow, because one number is a value, not a trend. */
const TREND_META = {
  lanes_waiting: { cell: "lanes",          of: "waiting",   goodUp: false },
  ahead_total:   { cell: "not on main",    of: "off main",  goodUp: false },
  unlanded_days: { cell: "oldest unlanded", of: "days stranded", goodUp: false },
  grill_outstanding: { cell: "grill", of: "outstanding", goodUp: false },
  tasks_done:    { cell: "tasks",          of: "done",      goodUp: true  },
  ctx_critical:  { cell: "ctx critical",   of: "ctx-critical", goodUp: false },
  estate_risk:   { cell: "estate at risk", of: "at risk",   goodUp: false },
  drafts_queued: { cell: "oldest draft",   of: "queued",    goodUp: false },
};

function baselineFor(hist, key, mark){
  if (!mark) return { why: "no baseline yet - first look here" };
  const usable = (hist || []).filter(h =>
    h && h.ts <= mark && h.v && h.v[key] !== null && h.v[key] !== undefined);
  if (!usable.length) {
    return { why: (hist || []).length
      ? "no reading before your last look"
      : "no observations yet" };
  }
  return { sample: usable[usable.length - 1] };
}

function trendSpan(key, current, s){
  const meta = TREND_META[key];
  if (current === null || current === undefined) {
    return `<span class="trend"><span class="none">not measured this refresh</span></span>`;
  }
  const b = baselineFor(s.trend, key, seenAt());
  if (b.why) return `<span class="trend"><span class="none">${esc(b.why)}</span></span>`;
  const was = b.sample.v[key];
  const at = new Date(b.sample.ts * 1000).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"});
  if (was === current) {
    return `<span class="trend"><span class="none">${meta.of} unchanged since ${at}</span></span>`;
  }
  const d = current - was;
  const better = meta.goodUp ? d > 0 : d < 0;
  return `<span class="trend"><b class="${better ? "good" : "bad"}">` +
    `${d > 0 ? "+" : ""}${d}</b> ${esc(meta.of)} since ${at}</span>`;
}

/* How long the oldest queued draft has waited for a tap. "none queued" and
   "we could not read the queue" are different answers and stay different. */
function draftsCell(s){
  const d = s.drafts_age;
  if (!d || d.state === "unreadable") {
    return ["oldest draft", "~/.zao/orca-drafts.json unreadable",
            `<b class="bad">unknown</b>`, "drafts_queued"];
  }
  if (!d.count) {
    return ["oldest draft", "~/.zao/orca-drafts.json",
            `<b class="nil">none queued</b>`, "drafts_queued"];
  }
  const undated = d.undated
    ? ` &middot; <b class="bad">${d.undated}</b> undated` : "";
  if (!d.oldest) {
    return ["oldest draft", "~/.zao/orca-drafts.json",
            `<b class="bad">age unknown</b> &middot; <b>${d.count}</b> queued`,
            "drafts_queued"];
  }
  const age = Date.now()/1000 - d.oldest;
  const cls = age > 21600 ? "bad" : age > 3600 ? "flag" : "good";
  return ["oldest draft", "~/.zao/orca-drafts.json",
          `<b class="${cls}">${ago(age)}</b> waiting &middot; ` +
          `<b>${d.count}</b> queued${undated}`, "drafts_queued",
          [age > 21600 ? ["bad", "draft waiting " + ago(age)] : null,
           d.undated ? ["bad", d.undated + " drafts undated"] : null]];
}

/* The grill depth, and whether it is actually stuck.

   Two ages, because they fail differently. cache_age is how long since
   zao-status-refresh wrote this file - if that is large the number is a
   fossil and nothing below it means anything. state_age is how long since
   the grill's own state moved on the VPS - if THAT is large the grill has
   stopped sending, which is the jam rather than a measurement problem. A
   surface that reported one age would call a dead refresher a jam, or a
   real jam fresh. */
function grillCell(s){
  const g = s.grill;
  const src = "~/.zao/status.json";
  if (!g || g.state !== "ok") {
    return ["grill", src + " unreadable",
            `<b class="bad">unknown</b>`, "grill_outstanding",
            [["bad", "grill unreadable"]]];
  }
  if (g.cache_age !== null && g.cache_age > 300) {
    // Refuse to render a depth from a refresher that has stopped.
    return ["grill", src + ", written by zao-status-refresh",
            `<b class="bad">stale ${ago(g.cache_age)}</b> - refresher stopped`,
            "grill_outstanding", [["bad", "grill reading stale " + ago(g.cache_age)]]];
  }
  if (g.outstanding === null) {
    return ["grill", src, `<b class="bad">depth unknown</b>` +
      (g.queued !== null ? ` &middot; <b>${g.queued}</b> queued` : ""),
      "grill_outstanding"];
  }
  const ceil = g.ceiling || 200;
  const jam = g.outstanding >= ceil;
  const near = !jam && g.outstanding >= ceil * 0.8;
  const cls = jam ? "bad" : near ? "flag" : "good";
  const quiet = (g.state_age !== null && g.state_age >= 3600)
    ? ` &middot; <b class="bad">silent ${ago(g.state_age)}</b>` : "";
  return ["grill", src,
    `<b class="${cls}">${g.outstanding}/${ceil}</b>${jam ? " JAMMED" : near ? " nearing" : ""}` +
    (g.queued !== null && g.queued !== g.outstanding
      ? ` &middot; <b class="nil">${g.queued}</b> queued` : "") + quiet,
    "grill_outstanding",
    [jam ? ["bad", "grill JAMMED " + g.outstanding + "/" + ceil]
     : near ? ["flag", "grill " + g.outstanding + "/" + ceil] : null,
     (g.state_age !== null && g.state_age >= 3600)
       ? ["bad", "grill silent " + ago(g.state_age)] : null]];
}

/* How long the oldest thing off main has been sitting there. `not on main`
   counts commits; 66 landed this morning and 3 stranded since July read the
   same there and do not read the same here. */
function unlandedCell(s){
  const e = s.estate;
  const src = "git log <base>..HEAD, last line";
  if (!e) {
    return ["oldest unlanded", "no worktree could be read",
            `<b class="bad">unknown</b>`, "unlanded_days"];
  }
  const unm = e.age_unmeasurable
    ? ` &middot; <b class="bad">${e.age_unmeasurable}</b> age unreadable` : "";
  if (!e.ahead_total) {
    return ["oldest unlanded", src, `<b class="nil">nothing off main</b>`,
            "unlanded_days"];
  }
  if (!e.oldest_unlanded) {
    return ["oldest unlanded", src,
            `<b class="bad">age unknown</b>${unm}`, "unlanded_days"];
  }
  // The headline age is the oldest thing NOT yet accounted for. Acking the
  // 58-day branch you parked on purpose promotes the next real one instead
  // of hiding the whole surface.
  const live = unhandled(s, e.ahead).filter(a => a.oldest);
  const pick = live.length ? live[0] : null;
  const acked = (e.ahead || []).length - unhandled(s, e.ahead).length;
  if (!pick) {
    return ["oldest unlanded", src,
      `<b class="nil">nothing unacked</b>` +
      (acked ? ` &middot; <b class="nil">${acked}</b> acked` : "") + unm,
      "unlanded_days"];
  }
  const age = Date.now()/1000 - pick.oldest;
  const cls = age > 14*86400 ? "bad" : age > 3*86400 ? "flag" : "good";
  const note = acked ? ` <span class="none">(oldest unacked)</span>` : "";
  return ["oldest unlanded", src,
          `<b class="${cls}">${ago(age)}</b> &middot; ${esc(pick.repo)}${note}${unm}`,
          "unlanded_days",
          [age > 14*86400 ? ["bad", "unlanded " + ago(age) + " " + pick.repo] : null]];
}

/* Work that has not reached main. Different question from `unpushed`: a
   branch pushed to origin is zero unpushed and still ahead of main, which is
   exactly the lane that commits steadily onto something that never lands. */
function aheadCell(s){
  const e = s.estate;
  if (!e) {
    return ["not on main", "no worktree could be read",
            `<b class="bad">unknown</b>`, "ahead_total"];
  }
  const unm = e.ahead_unmeasurable
    ? ` &middot; <b class="bad">${e.ahead_unmeasurable}</b> no main found` : "";
  if (!e.ahead_total) {
    return ["not on main", `rev-list origin/HEAD..HEAD, ${e.checked} worktrees`,
            `<b class="nil">0</b> commits off main${unm}`, "ahead_total"];
  }
  const ackedN = (e.ahead || []).length - unhandled(s, e.ahead).length;
  return ["not on main", `rev-list origin/HEAD..HEAD, ${e.checked} worktrees`,
          `<b class="flag">${e.ahead_total}</b> commits across ` +
          `<b>${e.ahead_repos}</b> lane${e.ahead_repos === 1 ? "" : "s"}${unm}` +
          (ackedN ? ` &middot; <b class="nil">${ackedN}</b> acked` : ""),
          "ahead_total"];
}

/* Work at risk across the live worktrees. Never a reassuring zero when the
   measurement failed - `unknown` is a real answer and a guessed 0 is not. */
function estateCell(s){
  const e = s.estate;
  if (!e) {
    return ["estate at risk", "no worktree could be read",
            `<b class="bad">unknown</b>`, "estate_risk",
            [["bad", "estate unreadable"]]];
  }
  const bit = (n, label, cls) =>
    `<b class="${n ? cls : "nil"}">${n}</b> ${label}`;
  const v = [bit(e.dirty, "dirty", "bad"),
             bit(e.unpushed, "unpushed", "flag"),
             bit(e.noremote, "no remote", "bad")]
            .join(" &middot; ")
            + (e.unmeasured ? ` &middot; <b class="bad">${e.unmeasured}</b> unreadable` : "");
  // `dirty` is chronic on a working estate and would sit in the summary
  // permanently. Only the two that mean "this exists nowhere else" or "we
  // could not look" get to interrupt.
  return ["estate at risk", `git status, ${e.checked} live worktrees`, v,
          "estate_risk",
          [e.noremote ? ["bad", e.noremote + " on no remote"] : null,
           e.unmeasured ? ["bad", e.unmeasured + " repos unreadable"] : null]];
}

/* The fleet, four numbers wide. A zero that should be zero renders dim; a
   number that means something is wrong renders warn or gold, so the strip
   is scannable without reading it. */
function strip(s){
  const P = s.panes || [], TC = s.task_counts || null;
  const n = r => P.filter(p => p.rank === r).length;
  const st = x => (TC && TC[x]) || 0;
  const critical = n(0), idle = n(5), blocked = st("blocked") + st("failed");
  const stuckAll = s.stuck || [];
  const stuck = unhandled(s, stuckAll).length;
  const stuckAcked = stuckAll.length - stuck;
  const e0 = s.estate, d0 = s.drafts_age;
  const trendNow = {
    lanes_waiting: P.length ? n(3) : null,
    tasks_done: TC ? st("completed") : null,
    ctx_critical: P.length ? n(0) : null,
    estate_risk: e0 ? e0.dirty + e0.unpushed + e0.noremote : null,
    drafts_queued: (d0 && d0.count !== null && d0.count !== undefined) ? d0.count : null,
    // Added in cycles 5, 6 and 10 server-side and never mirrored here, so
    // these three rendered "not measured this refresh" forever even while
    // the server was recording them. Found by a cold-start pass.
    ahead_total: e0 ? e0.ahead_total : null,
    unlanded_days: (e0 && e0.oldest_unlanded)
      ? Math.floor((Date.now()/1000 - e0.oldest_unlanded) / 86400) : null,
    grill_outstanding: (s.grill && s.grill.state === "ok"
      && s.grill.outstanding !== null && s.grill.outstanding !== undefined)
      ? s.grill.outstanding : null,
  };
  let wcls = "good", wtxt = "-";
  if (!s.watcher_alive) { wcls = "bad"; wtxt = "DOWN"; }
  else if (!s.watcher_ts) { wcls = "flag"; wtxt = "no log yet"; }
  else {
    const w = Date.now()/1000 - s.watcher_ts;
    wtxt = ago(w) + " ago";
    wcls = w > 300 ? "flag" : "good";
  }
  const cells = [
    ["lanes", stuck ? "orca-board + zorca-claims.json" : "orca-board --json",
      `<b>${n(4)}</b> working &middot; <b>${n(3)}</b> waiting &middot; ` +
      `<b class="${idle ? "flag" : "nil"}">${idle}</b> idle &middot; ` +
      `<b class="nil">${n(6)}</b> free` +
      (stuck ? ` &middot; <b class="bad">${stuck}</b> STUCK` : "") +
      (stuckAcked ? ` &middot; <b class="nil">${stuckAcked}</b> acked` : ""),
      "lanes_waiting",
      [stuck ? ["bad", stuck + " stuck"] : null,
       idle ? ["flag", idle + " idle"] : null]],
    ["tasks", "orchestration.db", `<b class="good">${st("completed")}</b> done &middot; ` +
      `<b class="flag">${st("ready")}</b> ready &middot; ` +
      `<b class="${blocked ? "bad" : "nil"}">${blocked}</b> blocked`, "tasks_done",
      [blocked ? ["bad", blocked + " tasks blocked"] : null]],
    ["ctx critical", "orca-board, rank 0", `<b class="${critical ? "bad" : "nil"}">${critical}</b>` +
      (critical ? " needs a handoff" : " - none near full"), "ctx_critical",
      [critical ? ["bad", critical + " ctx-critical"] : null]],
    ["watcher", "~/.zao/orca-board.log", `<b class="${wcls}">${wtxt}</b>`, null,
      [wcls === "bad" ? ["bad", "watcher " + wtxt]
       : wcls === "flag" ? ["flag", "watcher quiet " + wtxt] : null]],
    estateCell(s),
    draftsCell(s),
    aheadCell(s),
    unlandedCell(s),
    grillCell(s)
  ];
  // Nine readings do not fit above the action list on a 390px phone, and
  // the action list is the point. So the phone gets the SUMMARY - only the
  // stats that are not healthy, which is what a glance is for - and the
  // nine cells, their sources and their trends sit one tap down. A laptop
  // has the room and keeps them open.
  // Built from what each cell DECLARES is wrong, not from scanning its
  // markup for a colour class - the first attempt did that and reported
  // "tasks 20 done" as a problem, because a healthy cell still contains a
  // coloured number.
  const notable = [];
  cells.forEach(c => (c[4] || []).forEach(a => {
    if (a) notable.push(`<span class="${a[0]}">${esc(a[1])}</span>`);
  }));
  // The refresh-cost tripwire, with the thresholds named rather than left
  // to judgement. The loop ticks every 20s, so a refresh past 10s means the
  // board is scraping more than half the time and the cycle has started to
  // matter - which it does not today at 4.1s. 5s for a single stage names
  // the culprit rather than just the total. Measured 2026-08-26: board
  // 2.87s, estate 0.76s, everything else under 0.25s.
  (s.problems || []).forEach(pr => {
    notable.push(`<span class="bad">${esc(pr.where)} failing</span>`);
  });
  if (STORAGE_ERR) {
    notable.push(`<span class="bad">browser storage blocked</span>`);
  }
  const T = s.timings || {};
  if (s.refresh_secs > 10) {
    notable.push(`<span class="bad">refresh ${s.refresh_secs}s (over 10s)</span>`);
  }
  Object.keys(T).filter(k => T[k] > 5).forEach(k => {
    notable.push(`<span class="bad">${esc(k)} stage ${T[k]}s (over 5s)</span>`);
  });
  document.getElementById("stripsummary").innerHTML = notable.length
    ? notable.join(" &middot; ")
    : `<span class="ok">nothing wrong in ${cells.length} readings</span>`;
  const sf = document.getElementById("stripfold");
  if (sf.dataset.userset !== "1") sf.open = window.innerWidth > 900;
  document.getElementById("strip").innerHTML = cells.map(([k, src, v, tk]) =>
    `<div class="cell"><span class="k">${k}</span><span class="v">${v}</span>` +
    (tk ? trendSpan(tk, trendNow[tk], s)
        : `<span class="trend"><span class="none">no trend - freshness, not a stock</span></span>`) +
    `<span class="src">${esc(src)}</span></div>`).join("");
}

/* Only offer "show all" where there is more to show. */
function trimToggles(){
  document.querySelectorAll(".dtext").forEach(b => {
    const more = b.nextElementSibling;
    if (!more || !more.classList.contains("dmore")) return;
    more.style.display = b.classList.contains("open")
      || b.scrollHeight > b.clientHeight + 1 ? "inline-block" : "none";
  });
}

function expand(box, tag){
  const open = box.classList.toggle("open");
  const t = tag || box.nextElementSibling;
  if (t && t.classList.contains("dmore")) t.innerHTML = open ? "show less \u2191" : "show all \u2193";
}
function sendDraft(id, el, held){
  if (held && el.dataset.armed !== "1") {
    el.dataset.armed = "1";
    el.textContent = "confirm send";
    setTimeout(()=>{ if (el.dataset.armed === "1") {
      el.dataset.armed = ""; el.textContent = "Send"; } }, 6000);
    return;
  }
  post("/api/draft", {id: id, action: "send"}, el);
}
function ago(sec){
  if (sec < 90) return Math.round(sec) + "s";
  if (sec < 5400) return Math.round(sec/60) + "m";
  if (sec < 172800) return (sec/3600).toFixed(1) + "h";
  // Past two days, hours stop being readable - "1403.4h" is a number nobody
  // converts in their head. Found rendering a 58-day-old unlanded commit.
  if (sec < 5184000) return Math.round(sec/86400) + "d";
  return (sec/2592000).toFixed(1) + "mo";
}
function freshness(s){
  const at = new Date(s.ts*1000).toLocaleTimeString();
  const age = Date.now()/1000 - s.ts;
  let cls = "fresh", txt = "live";
  if (age >= 45) { cls = "aging"; txt = "as of " + at; }
  if (age > 90) { cls = "stale"; txt = "STALE " + ago(age) + " - refresher may be dead"; }
  if (s.err) {
    cls = "stale";
    // err_ts was in the payload from the start and nothing read it, so a
    // failing refresher never said HOW LONG it had been failing - which is
    // the difference between a blip and an outage. Found by a field audit.
    const since = s.err_ts
      ? " (since " + new Date(s.err_ts*1000).toLocaleTimeString() + ")" : "";
    txt = "STALE" + since + " - " + s.err;
  }
  document.getElementById("freshness").innerHTML =
    `<span class="${cls}">${esc(txt)}</span>` +
    (cls === "fresh" ? `<span class="at">${esc(at)}</span>` : "");
  document.getElementById("head").classList.toggle("warn", cls === "stale");
}

/* What a lane has DONE, beside what it is saying. `held` comes from zorca
   watching the state change, so a pane first seen already in this state
   reports "at least" rather than a duration nobody measured - same rule as
   the stuck surface. */
function workLine(p){
  const bits = [];
  if (p.held != null) {
    bits.push(`<span class="none">${p.held_assumed ? "at least " : ""}` +
              `${ago(p.held)} in this state</span>`);
  }
  if (p.last_ts) {
    const age = Date.now()/1000 - p.last_ts;
    const cls = age > 6*3600 ? "flag" : "good";
    bits.push(`<span class="${cls}">landed ${ago(age)} ago</span> ` +
              `<span class="none">${esc(p.last_sha)} ${esc((p.last_text || "").slice(0, 46))}</span>`);
  } else if (p.cwd_missing !== undefined || p.last_sha === "") {
    bits.push(`<span class="none">no commit readable in this worktree</span>`);
  }
  return bits.length
    ? `<div class="worked">${bits.join(" &middot; ")}</div>` : "";
}

