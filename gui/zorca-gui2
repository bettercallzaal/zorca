<script>
const INFLIGHT = new Set();
async function post(url, body, el){
  const key = url + "|" + (body.id || body.handle || body.i);
  if (INFLIGHT.has(key)) return;
  INFLIGHT.add(key);
  if (el) { el.disabled = true; el.dataset.was = el.textContent; el.textContent = "..."; }
  let ok = false, why = "";
  try {
    const r = await fetch(url, {method:"POST", body: JSON.stringify(body)});
    ok = r.ok;
    if (!ok) why = " (" + r.status + ")";
  } catch (e) {
    why = " (no server)";
  }
  toast(ok ? "done" : "failed" + why, ok);
  INFLIGHT.delete(key);
  if (el && el.dataset.was) { el.disabled = false; el.textContent = el.dataset.was; }
  load();
}
function toast(msg, ok){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.className = ok ? "" : "bad";
  t.style.display = "block";
  setTimeout(()=>t.style.display="none", ok ? 1800 : 4000);
}
function esc(s){ const d=document.createElement("div"); d.textContent=s||""; return d.innerHTML; }

/* ZORCA already holds danger-worded drafts on rail 1. The GUI was the one
   surface where that hold was invisible - this only renders it. No override
   is added: a held draft is still sendable, it just costs a second tap. */
const DANGER = /license|publish|delete|archive|push|merge|rotate|credential/i;
function danger(reason){
  const m = DANGER.exec(reason || "");
  return m ? m[0].toLowerCase() : "";
}
function sendDraft(id, el, held){
  if (held && el.dataset.armed !== "1") {
    el.dataset.armed = "1";
    el.textContent = "confirm send";
    setTimeout(()=>{ if (el.dataset.armed === "1") {
      el.dataset.armed = ""; el.textContent = "Send"; } }, 6000);
    return;
  }
  post("/api/draft", {id: id, action: "send"}, el);
}
function ago(sec){
  if (sec < 90) return Math.round(sec) + "s";
  if (sec < 5400) return Math.round(sec/60) + "m";
  return (sec/3600).toFixed(1) + "h";
}
function freshness(s){
  const at = new Date(s.ts*1000).toLocaleTimeString();
  const age = Date.now()/1000 - s.ts;
  let cls = "fresh", txt = "live";
  if (age >= 45) { cls = "aging"; txt = "as of " + at; }
  if (age > 90) { cls = "stale"; txt = "STALE " + ago(age) + " - refresher may be dead"; }
  if (s.err) { cls = "stale"; txt = "STALE - " + s.err; }
  document.getElementById("freshness").innerHTML =
    `<span class="${cls}">${esc(txt)}</span>` +
    (cls === "fresh" ? `<span class="at">${esc(at)}</span>` : "");
  document.getElementById("head").classList.toggle("warn", cls === "stale");
}

/* A pane row. The state string is always rendered as text - the chip colour
   is the redundant channel, never the only one. */
function paneRow(p, dup){
  const hot = p.ctx != null && p.ctx >= 85;
  const ctx = p.ctx == null ? "-"
            : (hot ? p.ctx + "% - hand off" : p.ctx + "%");
  return `<div class="card pane${dup ? " dup" : ""}" onclick='post("/api/focus",{handle:"${p.handle}"}, this)'>
      <span class="repo">${esc(p.repo)}</span>
      <span class="chip r${p.rank}">${esc(p.state)}</span>
      <span class="ctx${hot ? " hot" : ""}">${ctx}</span>
      <span class="detail">${esc(p.question || p.tail || "")}</span>
    </div>`;
}

async function load(){
  const s = await (await fetch("/api/state")).json();
  document.getElementById("run").textContent = s.run;
  freshness(s);

  /* --- rail 1: gates, drafts, and only the panes that asked you ------ */
  const hot = s.panes.filter(p => p.rank <= 2);
  const need = s.gates.length + s.drafts.length + hot.length;
  document.getElementById("needcount").textContent =
    need === 0 ? "0 need you - the wall is working" : need + " need you";
  document.getElementById("needsyou").classList.toggle("clear", need === 0);

  document.getElementById("gates").innerHTML = s.gates.map(g => `
    <div class="card gate">
      <div class="q" style="white-space:pre-wrap">${esc(g.question)}</div>
      <div class="stamp" style="margin-bottom:8px">filed ${esc(g.created_at||"")}
        &middot; task ${esc(g.task_id||"")}</div>
      <div>
        ${g.options.map(o=>`<button onclick='post("/api/resolve",
          {id:"${g.id}",resolution:${JSON.stringify(o)}}, this)'>${esc(o)}</button>`).join("")}
        ${g.options.length==0?`<button onclick='post("/api/resolve",
          {id:"${g.id}",resolution:"Closed by Zaal from ZORCA GUI: addressed, no further action."}, this)'
          >close - addressed</button>`:""}
        <input type="text" id="in-${g.id}" placeholder="or type an answer">
        <button onclick='post("/api/resolve",{id:"${g.id}",
          resolution:document.getElementById("in-${g.id}").value}, this)'>send</button>
      </div>
    </div>`).join("");

  document.getElementById("drafts").innerHTML = s.drafts.map(d => {
    const hit = danger(d.reason);
    return `
    <div class="card gate${hit ? " held" : ""}">
      <div class="q"><b>${esc(d.repo)}</b>
        <span class="stamp">${esc(d.reason)}</span></div>
      ${hit ? `<div class="heldlabel">HELD - danger word: ${esc(hit)}</div>` : ""}
      <div class="detail" style="white-space:normal;margin-bottom:8px">${esc(d.text)}</div>
      <button onclick='sendDraft("${d.id}", this, ${hit ? "true" : "false"})'>Send</button>
      <button onclick='post("/api/draft",{id:"${d.id}",action:"skip"}, this)'>Skip</button>
    </div>`;
  }).join("");

  document.getElementById("hotpanes").innerHTML = hot.map(paneRow).join("");

  /* --- rail 2: the wall. Free and finished lanes collapse into the
         summary; a card here means a lane that is actually running. --- */
  const live = s.panes.filter(p => p.rank <= 4);
  const working = s.panes.filter(p => p.rank == 3 || p.rank == 4).length;
  const free = s.panes.filter(p => p.rank == 6).length;
  const idle = s.panes.filter(p => p.rank == 5).length;
  document.getElementById("wallsummary").innerHTML =
    `${working} working &middot; ${free} free &middot; ` +
    `<span class="${idle ? "idle" : ""}">${idle} idle</span>`;
  document.getElementById("panes").innerHTML =
    live.map(p => paneRow(p, p.rank <= 2)).join("")
    || '<div class="card">no live panes</div>';
  document.getElementById("coldpanes").innerHTML =
    s.panes.filter(p => p.rank >= 5).map(paneRow).join("")
    || '<span class="stamp">none</span>';

  /* --- rail 3: reference ------------------------------------------- */
  document.getElementById("tasks").innerHTML = s.tasks.map((t,i) => `
    <div class="task" style="cursor:pointer" onclick='
      const el=document.getElementById("spec-"+${i});
      el.style.display = el.style.display=="none" ? "block" : "none";'>
      <span class="st st-${t.status}">${t.status}</span>
      <span>${esc(t.title)}</span></div>
    <div id="spec-${i}" style="display:none" class="detail"
      ><div style="white-space:normal;padding:4px 0 10px 112px">
      ${esc(t.spec)}<br><span class="stamp">${t.id} &middot; ${esc(t.updated)}</span>
      </div></div>`).join("");
  document.getElementById("resolved").innerHTML = s.resolved.map(g => `
    <div class="task"><span class="st st-completed">resolved</span>
      <span>${esc(g.question.slice(0,70))} &rarr; <b>${esc(g.resolution||"")}</b></span>
    </div>`).join("") || '<span class="stamp">none yet</span>';
  document.getElementById("lanes").innerHTML = s.lanes.map((l,i) => `
    <div class="task"><button class="mini"
      onclick='post("/api/lane",{i:${i}}, this)'>open</button>
      <span>${esc(l.name)}</span>
      <span class="stamp">${esc(l.worktree.replace(/^.*zaalpanthaki/,"~"))}</span>
    </div>`).join("") || '<span class="stamp">no parked lanes</span>';
  document.getElementById("wlog").innerHTML = s.log.map(l => {
    // The two-character prefix is the real signal; colour is the echo.
