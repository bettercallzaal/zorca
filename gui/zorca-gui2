# rather than trusted forever.
ACK_STALE_S = int(os.environ.get("ZORCA_ACK_STALE_S", str(7 * 86400)))
# /api/ack is read-modify-write on one file, and ThreadingHTTPServer runs
# handlers concurrently. Two acks landing together each read the same map,
# each add their own key, and the second write drops the first - observed,
# not theorised: three acks fired at once left one in the file.
ACK_LOCK = threading.Lock()

# Every subsystem that failed to read or write, and why.
#
# Three times this session the same shape has bitten: a layer failed,
# swallowed it, and the board reported a confident zero. The refresher
# (cycle 1), the cold start (cycle 12), the renderer (cycle 17). Rather than
# wait for the fourth, every swallow site records here. Set on failure,
# CLEARED on the next success, so a fixed problem stops shouting on its own.
PROBLEMS = {}
PROBLEMS_LOCK = threading.Lock()


def problem(where, exc=None, why=""):
    with PROBLEMS_LOCK:
        PROBLEMS[where] = {
            "why": why or ("%s: %s" % (type(exc).__name__, exc) if exc else "failed"),
            "ts": time.time(),
        }


def solved(where):
    with PROBLEMS_LOCK:
        PROBLEMS.pop(where, None)

