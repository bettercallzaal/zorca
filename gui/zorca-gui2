VAULT_DAILY = os.environ.get(
    "ZORCA_VAULT_DAILY", os.path.expanduser("~/zao-vault/daily"))


def daily_events(n=12):
    """The human-readable events feed: `## HH:MM - title` in today's daily.

    Timestamps are PARSED, never string-compared (zaal-dotfiles a979b96: a
    malformed value sorts above or below a cutoff by ASCII accident, and one
    of those directions silently drops the row). A heading whose time will
    not parse keeps ts=0 and is still shown, labelled - dropping an event
    from a "what happened" feed is the one failure this surface cannot have.
    """
    day = time.strftime("%Y-%m-%d")
    path = os.path.join(VAULT_DAILY, day + ".md")
    rows = []
    try:
        lines = open(path).read().splitlines()
        solved("vault daily log")
    except Exception as e:
        # No file at all is normal early in a day; anything else is not.
        if not isinstance(e, (FileNotFoundError, IsADirectoryError)):
            problem("vault daily log", e)
        return []
    for i, ln in enumerate(lines):
        if not ln.startswith("## "):
            continue
        head = ln[3:].strip()
        stamp, _, title = head.partition(" - ")
        ts = 0
        try:
            hh, mm = stamp.split(":")
            lt = time.localtime()
            ts = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday,
                              int(hh), int(mm), 0, 0, 0, -1))
        except Exception:
            title, ts = head, 0
        # "absorb tick" twelve times in a row is a heading, not an event.
        # The first bullet under it is what actually happened.
        detail = ""
        for nxt in lines[i + 1:i + 8]:
            if nxt.startswith("## "):
                break
            t = nxt.strip().lstrip("-*").strip()
            if t:
                detail = t
                break
        rows.append(dict(ts=ts, text=title or head, detail=detail,
                         src="vault daily " + day + ".md"))
    rows.sort(key=lambda r: r["ts"], reverse=True)
    seen, out = set(), []
    for r in rows:
        key = (r["text"], r["detail"])
        if key in seen:
            continue
        seen.add(key)
        out.append(r)
    return out[:n]


def git_scan(cwds):
    """Last commit per live worktree - proof of work, not pane text.

    A pane's tail says what an agent is saying; a commit says what it landed.
    """
    rows, seen = [], set()
    for cwd in cwds:
        if not cwd or cwd in seen or not os.path.isdir(cwd):
            continue
        seen.add(cwd)
        out = sh(["git", "-C", cwd, "log", "-1", "--format=%ct\x1f%h\x1f%s"],
                 timeout=10)
        parts = out.strip().split("\x1f")
        if len(parts) != 3:
            continue
        try:
            ts = int(parts[0])
        except ValueError:
            continue
        rows.append(dict(ts=ts, repo=os.path.basename(cwd), sha=parts[1],
                         text=parts[2], cwd=cwd,
                         src="git -C " + cwd + " log -1"))
    rows.sort(key=lambda r: r["ts"], reverse=True)
    return rows


CLAIMS = os.environ.get("ZORCA_CLAIMS",
                        os.path.expanduser("~/.zao/zorca-claims.json"))
STALE_CLAIM_S = int(os.environ.get("ZORCA_STALE_CLAIM_S", "2700"))  # 45 min


def claims_update(board, now=None):
    """How long each pane has been claiming its current state.

    orca-board reports state but not since-when, so this observes it: the
    state per handle is written to disk every refresh and the timestamp only
    moves when the state actually changes.

    It CANNOT know how long a pane was in a state before zorca first saw it.
    That gap is carried as `assumed`, not papered over - a pane first seen
    already working reports "at least Nm", never a duration we did not
    measure.
    """
    now = now or time.time()
    try:
        old = json.load(open(CLAIMS))
        if not isinstance(old, dict):
            raise ValueError("claims file is not an object")
        solved("claims history")
    except FileNotFoundError:
        old = {}
    except Exception as e:
        # Recovering by resetting is right; doing it quietly is not - every
        # duration on the stuck surface just went back to zero.
        problem("claims history", e, why="unreadable, every stuck duration reset: %s" % e)
        old = {}
    if not board:
        # A blank board is almost always a transient scrape failure, not
        # fifteen panes closing at once. Overwriting on it would reset every
        # accumulated duration to zero and the stale-claim surface would go
        # quiet exactly when it had the most to say.
        return old
    new = {}
    for p in board:
        h = p.get("handle")
        if not h:
            continue
        prev = old.get(h) or {}
        if prev.get("state") == p.get("state"):
            new[h] = prev
        else:
            new[h] = {"state": p.get("state"), "since": now,
                      # first sight of this handle: the state may predate us
                      "assumed": h not in old}
    try:
        tmp = CLAIMS + ".tmp"
        os.makedirs(os.path.dirname(CLAIMS), exist_ok=True)
        # Write through a temp file: a half-written claims file would reset
        # every duration on the next read, which is worse than no file.
        json.dump(new, open(tmp, "w"), indent=1)
        os.replace(tmp, CLAIMS)
        solved("claims file")
    except Exception as e:
        # A claims file that will not write means every stuck duration
        # silently resets on the next restart.
        problem("claims file", e)
    return new


def stuck_lanes(board, gitmap, claims, now=None):
    """A lane claiming to work with nothing landed since the claim began.

    Only rank 3-4 - a lane that is waiting on Zaal is not stuck, it is
    blocked, and that is rail 1's job. A pane whose cwd is not a git repo is
    skipped entirely: we cannot measure it, so we do not judge it.
    """
    now = now or time.time()
    out = []
    for p in board:
        if p.get("rank") not in (3, 4):
            continue
        c = claims.get(p.get("handle")) or {}
        since = c.get("since")
        if not since:
            continue
        held = now - since
        if held < STALE_CLAIM_S:
            continue
        last = gitmap.get(p.get("cwd") or "")
        if not last:
            continue
        if last["ts"] > since:
            continue
        out.append(dict(repo=p.get("repo") or "?", handle=p.get("handle"),
                        key="stuck:%s:%d" % (p.get("handle"), int(since)),
                        state=p.get("state"), held=int(held),
                        assumed=bool(c.get("assumed")),
                        last_ts=last["ts"], last_sha=last["sha"],
                        last_text=last["text"], cwd=p.get("cwd"),
                        src="orca-board state + git -C " + (p.get("cwd") or "?")
                            + " log -1, tracked in " + CLAIMS))
    out.sort(key=lambda r: -r["held"])
    # Two counts alongside the rows, because "nothing stuck" has two very
    # different causes and the surface was stating the flattering one. A
    # cold start has candidates but zero observed, and saying "every working
    # lane has landed something" there is a claim we cannot support for
    # another 45 minutes.
    candidates = sum(1 for p in board if p.get("rank") in (3, 4))
    observed = 0
    for p in board:
        if p.get("rank") not in (3, 4):
            continue
        since = (claims.get(p.get("handle")) or {}).get("since")
        if since and (now - since) >= STALE_CLAIM_S:
            observed += 1
    return out, candidates, observed


INFLIGHT = os.environ.get(
    "ZORCA_INFLIGHT",
    os.path.expanduser("~/zao-vault/handoffs/IN-FLIGHT.md"))


def _norm(v):
    return "".join(c for c in (v or "").lower() if c.isalnum())


def inflight_orphans(board, now=None, n=8):
    """IN-FLIGHT rows whose lane has no live pane - claims nobody is holding.

    The file is the cross-lane map: `| lane | doing | claimed | when |`. A
    row is a lane saying "I am on this". When the lane is gone and the row
    is not, the claim outlives the work, and the next lane reads it as live.

    Matching a lane name to a pane is fuzzy on purpose - `fractal` runs in
    `ZAOfractal`, `meetings` in `zaomeetings` - so it is containment on the
    alphanumerics of both. The rule is printed in the row's source line
    rather than hidden, because a fuzzy match that claims to be exact is
    worse than one that says what it did.

    Dates are PARSED (a979b96). A row whose date will not parse is kept and
    shown undated - never dropped, because a claim we cannot date is exactly
    the kind that has been sitting longest.
    """
    now = now or time.time()
    rows = []
    try:
        for ln in open(INFLIGHT):
            if not ln.startswith("|"):
                continue
            cells = [c.strip() for c in ln.strip().strip("|").split("|")]
            if len(cells) < 4 or cells[0].lower() == "lane" or set(cells[0]) <= set("- "):
                continue
            ts = 0
            try:
                ts = time.mktime(time.strptime(cells[3][:10], "%Y-%m-%d"))
            except Exception:
                ts = 0
            rows.append(dict(lane=cells[0], doing=cells[1], when=cells[3], ts=ts))
    except Exception as e:
        # Returning a bare [] here crashed the caller's tuple unpack and took
        # the WHOLE refresh down - live since cycle 2, never hit because the
        # file always existed. Found by the silent-failure sweep.
        problem("IN-FLIGHT.md", e)
        return [], 0
    solved("IN-FLIGHT.md")
    # One lane, many rows - the newest row is the lane's current claim.
    newest = {}
    for r in rows:
        cur = newest.get(r["lane"])
        if cur is None or r["ts"] > cur["ts"]:
            newest[r["lane"]] = r
    live = [_norm(p.get("repo")) for p in board if p.get("repo")]
    live += [_norm(os.path.basename(p.get("cwd") or "")) for p in board if p.get("cwd")]
    live = [x for x in live if x]
    out = []
    for r in newest.values():
        lane = _norm(r["lane"])
        if not lane:
            continue
        if any(lane in x or x in lane for x in live):
            continue
        # A row that says the lane closed is an accurate record, not an
        # outliving claim. Counting it would make the surface cry wolf about
        # the one kind of row that did its job.
        if "lane closed" in r["doing"].lower():
            continue
        r = dict(r)
        r["age_days"] = int((now - r["ts"]) / 86400) if r["ts"] else None
        r["src"] = "no live pane matching \"%s\"" % r["lane"]
        r["key"] = "orphan:%s:%s" % (r["lane"], r["when"])
        out.append(r)
    # Oldest claim first - the longer a row outlives its lane, the more
    # confidently the next lane will believe it.
    out.sort(key=lambda r: (r["ts"] or 0))
    return out[:n], len(out)


ESTATE_NOTE = os.environ.get(
    "ZORCA_ESTATE_NOTE",
    os.path.expanduser("~/zao-vault/notes/repo-estate.md"))


def sh2(args, timeout=15):
    """Like sh(), but the caller can tell failure from an empty result.

    `git status --porcelain` returns "" for a clean tree AND sh() returns ""
    for a crash. Collapsing those would report a repo that could not be read
    as a repo with nothing to lose, which is the worst direction for this
    number to be wrong in.
    """
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except Exception:
        return -1, ""


# Default-branch candidates in the order they should be trusted. origin/HEAD
# is the repo's own answer; the rest are the conventions to fall back on.
BASE_REFS = ("origin/HEAD", "origin/main", "origin/master", "main", "master")


def _ahead_of_main(cwd):
    """(commits ahead of the default branch, which ref, oldest unlanded ts).

    (None, "", None) when no default branch could be resolved or the count
    could not be read - a repo whose main we cannot find is not a repo with
    nothing outstanding.

    The oldest unlanded commit is the LAST line of `git log <base>..HEAD`,
    not `git log -1`. `-1` returns the newest commit in the range, which
    answers "when did this lane last commit" - a question two other surfaces
    already answer. The one nothing answers is how long the oldest thing has
    been sitting off main, and that is the last line, because git logs
    newest-first.

    `oldest` is None when the count is known but the log could not be read,
    so a measurable count never drags an unmeasurable age along with it.
    """
    for ref in BASE_REFS:
        rc, out = sh2(["git", "-C", cwd, "rev-parse", "--verify", "--quiet", ref])
        if rc != 0 or not out.strip():
            continue
        rc2, out2 = sh2(["git", "-C", cwd, "rev-list", "--count", ref + "..HEAD"])
        if rc2 != 0:
            return None, "", None
        try:
            n = int(out2.strip() or "0")
        except ValueError:
            return None, "", None
        if n == 0:
            return 0, ref, 0
        rc3, out3 = sh2(["git", "-C", cwd, "log", ref + "..HEAD", "--format=%ct"])
        oldest = None
        if rc3 == 0:
            stamps = [l for l in out3.split() if l.strip().isdigit()]
            if stamps:
                oldest = int(stamps[-1])
        return n, ref, oldest
    return None, "", None


def estate_sweep(cwds):
    """Work at risk across the LIVE worktrees - measured, never estimated.

    Scoped to the worktrees on the board rather than the whole mac: the full
    estate is 48 local clones and sweeping them every 20s would cost more
    than it tells you. This is the subset that is running right now, which is
    where uncommitted work is actually being made.

    Anything that cannot be read is counted as `unmeasured` and said out
    loud. A repo we failed to read is not a repo with nothing at risk.

    Also measures ahead-of-main in the same pass, because it is the same loop
    over the same repos and spawning git twice per worktree would double the
    cost of the slowest part of the refresh. The two are different questions:
    `unpushed` is ahead of the branch's OWN upstream, so a pushed branch is
    zero; `ahead` is ahead of the default branch, which stays non-zero for
    every commit that has not merged. A lane committing steadily onto a
    branch that never lands reads as healthy on the first and does not on the
    second.
    """
    dirty = unpushed = noremote = unmeasured = 0
    ahead_rows, ahead_unmeasurable, age_unmeasurable = [], 0, 0
    seen, checked = set(), 0
    for cwd in cwds:
        if not cwd or cwd in seen:
            continue
        seen.add(cwd)
        if not os.path.isdir(cwd):
            continue
        checked += 1
        rc, out = sh2(["git", "-C", cwd, "status", "--porcelain"])
        if rc != 0:
            unmeasured += 1
            continue
        if out.strip():
            dirty += 1
        n_ahead, base, oldest_ts = _ahead_of_main(cwd)
        if n_ahead is None:
            ahead_unmeasurable += 1
        elif n_ahead > 0:
            if oldest_ts is None:
                age_unmeasurable += 1
            ahead_rows.append(dict(repo=os.path.basename(cwd), n=n_ahead,
                                   base=base, cwd=cwd, oldest=oldest_ts,
                                   key="unlanded:%s:%s" % (cwd, oldest_ts or 0)))
        rc2, out2 = sh2(["git", "-C", cwd, "rev-list", "--count", "@{u}..HEAD"])
        if rc2 != 0:
            # No upstream at all: the branch exists only on this disk.
            noremote += 1
            continue
        try:
            if int(out2.strip() or "0") > 0:
                unpushed += 1
        except ValueError:
            unmeasured += 1
    if not checked:
        # A blank board is a scrape failure, not an estate with nothing in
        # it. Say unknown rather than paint a reassuring zero.
        return None
    swept = ""
    try:
        for ln in open(ESTATE_NOTE):
            if "Measured " in ln:
                token = ln.split("Measured ", 1)[1].split()[0].strip("`.,")
                # Parsed, not trusted as a string (a979b96).
                time.strptime(token, "%Y-%m-%d")
                swept = token
                break
    except Exception:
        swept = ""
    # Oldest unlanded work first: 3 commits stranded since July matter more
    # than 66 from this morning, and sorting by count buries exactly that.
    ahead_rows.sort(key=lambda r: (r["oldest"] is None, r["oldest"] or 0))
    dated = [r["oldest"] for r in ahead_rows if r["oldest"]]
    return dict(checked=checked, dirty=dirty, unpushed=unpushed,
                noremote=noremote, unmeasured=unmeasured, full_swept=swept,
                note=ESTATE_NOTE, ahead=ahead_rows[:10],
                oldest_unlanded=(min(dated) if dated else 0),
                age_unmeasurable=age_unmeasurable,
                ahead_total=sum(r["n"] for r in ahead_rows),
                ahead_repos=len(ahead_rows),
                ahead_unmeasurable=ahead_unmeasurable)


def drafts_age(now=None):
    """How long the oldest queued draft has been waiting for a tap.

    queue_read() returns [] on any failure, which cannot tell an empty queue
    from an unreadable one - the same collapse sh() made. This reads the file
    itself so "nothing is waiting" and "we could not look" stay different
    answers.

    A draft with no usable ts is counted `undated` and never assumed fresh.
    The watcher has always written ts, but a hand-edited queue is exactly the
    case where a guessed age would be wrong and confident.
    """
    now = now or time.time()
    if not os.path.exists(QUEUE):
        return dict(state="empty", count=0, oldest=0, undated=0)
    try:
        items = json.load(open(QUEUE))
        if not isinstance(items, list):
            raise ValueError("queue is not a list")
    except Exception as e:
        return dict(state="unreadable", count=None, oldest=0, undated=0,
                    why="%s: %s" % (type(e).__name__, e))
    oldest, undated = 0, 0
    for i in items:
        ts = (i or {}).get("ts")
        try:
            ts = float(ts)
            if ts <= 0:
                raise ValueError
        except (TypeError, ValueError):
            undated += 1
            continue
        if oldest == 0 or ts < oldest:
            oldest = ts
    return dict(state="ok", count=len(items), oldest=oldest, undated=undated)


TREND = os.environ.get("ZORCA_TREND",
                       os.path.expanduser("~/.zao/zorca-trend.json"))
TREND_BUCKET = 600         # one sample per 10 minutes
TREND_POINTS = 150         # ~25h of buckets, which is what is kept AND served


def trend_record(values, now=None):
    """Append this refresh's readings so a later one can be compared to it.

    A stat that could not be measured is recorded as null, never as zero. A
    zero would read as a real observation and a later comparison against it
    would invent a trend out of a failed scrape - which is the exact thing a
    trend arrow must never do.

    Returns the decimated series to serve: at most one sample per 10 minutes,
    newest kept, so the payload stays small while still reaching back a day.
    """
    now = now or time.time()
    try:
        hist = json.load(open(TREND))
        if not isinstance(hist, list):
            raise ValueError("trend file is not a list")
        solved("trend history")
    except FileNotFoundError:
        hist = []
    except Exception as e:
        problem("trend history", e, why="unreadable, trend baselines reset: %s" % e)
        hist = []
    hist = [h for h in hist if isinstance(h, dict) and h.get("ts")]
    if any(v is not None for v in values.values()):
        hist.append(dict(ts=int(now), v=values))
    # Store what is served, not raw samples that are thrown away.
    #
    # This used to keep 24h at one sample per 20s - 4320 rows, 835 KB - and
    # rewrite the whole file every refresh, which is 3.6 GB of disk writes a
    # day for a dashboard. Every one of those rows was then decimated to
    # one per 10 minutes before serving, so 97% of that was written and
    # discarded. Keeping the decimated series loses nothing: the served
    # resolution has always been ten minutes.
    #
    # The newest sample in each bucket wins, so the current bucket updates
    # in place as the refresh loop runs.
    out, seen = [], set()
    for h in reversed(hist):
        b = int(h["ts"] // TREND_BUCKET)
        if b in seen:
            continue
        seen.add(b)
        out.append(h)
        if len(out) >= TREND_POINTS:
            break
    out.reverse()
    try:
        tmp = TREND + ".tmp"
        os.makedirs(os.path.dirname(TREND), exist_ok=True)
        json.dump(out, open(tmp, "w"))
        os.replace(tmp, TREND)
        solved("trend file")
    except Exception as e:
        problem("trend file", e)
    return out


def trend_values(board, tasks, estate, dage, grill=None):
    """The one scalar per stat that a direction can be argued about.

    Deliberately not every number in a cell. "3 working / 9 waiting / 0 idle"
    has no single direction, so the trended scalar is named on the surface
    rather than left for the reader to guess at.
    """
    def rank(r):
        return sum(1 for p in board if p.get("rank") == r) if board else None
    st = (lambda x: sum(1 for t in tasks if t.get("status") == x)) if tasks else None
    return {
        "lanes_waiting": rank(3),
        "tasks_done": st("completed") if st else None,
        "ctx_critical": rank(0),
        "estate_risk": (None if not estate else
                        estate["dirty"] + estate["unpushed"] + estate["noremote"]),
        "ahead_total": None if not estate else estate["ahead_total"],
        "unlanded_days": (None if not estate or not estate["oldest_unlanded"]
                          else int((time.time() - estate["oldest_unlanded"]) / 86400)),
        "drafts_queued": (None if not dage or dage.get("count") is None
                          else dage["count"]),
        "grill_outstanding": (grill.get("outstanding")
                              if grill and grill.get("state") == "ok" else None),
    }


def acks_read():
    try:
        d = json.load(open(ACKS))
        if not isinstance(d, dict):
            raise ValueError("acks file is not an object")
        solved("acks history")
        return d
    except FileNotFoundError:
        return {}
    except Exception as e:
        problem("acks history", e, why="unreadable, everything reads unacked: %s" % e)
        return {}


def acks_write(d):
    """Never prunes on absence.

    A key missing from this refresh may be a transient scrape failure rather
    than a resolved item, and dropping the ack then would resurrect it as
    unhandled the moment the scrape recovered. Keys embed the fact they
    describe, so a changed fact makes a new key and the old one ages out on
    time alone.
    """
    cutoff = time.time() - 90 * 86400
    d = {k: v for k, v in d.items() if isinstance(v, (int, float)) and v > cutoff}
    try:
        tmp = ACKS + ".tmp"
        os.makedirs(os.path.dirname(ACKS), exist_ok=True)
        json.dump(d, open(tmp, "w"), indent=1)
        os.replace(tmp, ACKS)
        solved("acks file")
    except Exception as e:
        # The tap looked like it worked and the ack is not on disk.
        problem("acks file", e)
    return d


STATUS_JSON = os.environ.get(
    "ZORCA_STATUS_JSON", os.path.expanduser("~/.zao/status.json"))
GRILL_CEILING = int(os.environ.get("ZORCA_GRILL_CEILING", "200"))


def grill_state(now=None):
    """The grill depth, read from the statusline cache rather than re-measured.

    ~/.zao/status.json is written by ~/bin/zao-status-refresh, which SSHes
    the VPS. Re-running that here would put an 8-second network round trip
    inside a 20-second refresh loop for a number another process already
    keeps current. What this owns instead is saying how old that number is,
    which the cache itself carries two different ways:

      cache_age - since zao-status-refresh last wrote. If this is large the
                  refresher is dead and every number below it is a fossil.
      state_age - since the grill's own state file last moved on the VPS.
                  Large means the grill has stopped sending, which is the
                  jam itself rather than a measurement problem.

    `outstanding` is the 12h-windowed count the gate compares against the
    ceiling; `queued` is every card ever asked and unanswered. They are
    different quantities and were conflated until zaal-dotfiles a979b96.
    """
    now = now or time.time()
    try:
        d = json.load(open(STATUS_JSON))
        if not isinstance(d, dict):
            raise ValueError("status cache is not an object")
    except Exception as e:
        return dict(state="unreadable", why="%s: %s" % (type(e).__name__, e))

    def num(k):
        v = d.get(k)
        try:
            return int(str(v).strip())
        except (TypeError, ValueError):
            return None

    ts = d.get("ts")
    try:
        cache_age = int(now - float(ts)) if ts else None
    except (TypeError, ValueError):
        cache_age = None
    return dict(state="ok", outstanding=num("grill"), queued=num("grill_queued"),
                state_age=num("grill_age"), cache_age=cache_age,
                ceiling=GRILL_CEILING, src=STATUS_JSON)


def watcher():
    """Two facts, because either alone lies.

    The watcher only writes when it holds, queues or sends - there is no
    heartbeat line - so a silent log can mean "quiet" or "dead". Pair the
    last write with whether the process is actually alive.
    """
    alive = False
    try:
        alive = subprocess.run(["pgrep", "-f", "orca-board --auto"],
                               capture_output=True, timeout=5).returncode == 0
    except Exception:
        pass
    ts = 0
    try:
        ts = os.path.getmtime(BOARD_LOG)
    except Exception:
        pass
    return alive, ts


def tail_log(n=14):
    """Last lines of the watcher log - the HOLD/QUEUE/SENT trail."""
    try:
        with open(BOARD_LOG, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 8192))
            lines = f.read().decode(errors="replace").splitlines()
        solved("watcher log")
        return [l for l in lines if l.strip()][-n:]
    except Exception as e:
        # A missing log is normal before the watcher first writes; an
        # unreadable one means the trail below is empty for a reason the
        # page would otherwise present as "watcher not running".
        if not isinstance(e, FileNotFoundError):
            problem("watcher log", e)
        return []


def current_run():
    """Terminal bindings die on every Orca restart; discover, never bind."""
    for ln in sh([ORCA, "orchestration", "run-list"], strict=True).splitlines():
        if ln.startswith("run_") and "legacy" not in ln:
            return ln.split()[0]
    return ""


class Stages(object):
    """Wall-clock per stage of a refresh, so tuning aims at the slow half.

    Kept in the payload rather than a log line: a number you have to go
    looking for is a number nobody looks at, and this one decides what is
    worth optimising.
    """

    def __init__(self):
        self.t = {}

    def time(self, name):
        outer = self

        class _T(object):
            def __enter__(self):
                self.t0 = time.time()
                return self

            def __exit__(self, *a):
                outer.t[name] = round(time.time() - self.t0, 2)
                return False
        return _T()


def refresh():
    st = Stages()
    # No bare except here: if orca-board is gone or its JSON is garbage the
    # board is blind, and a blind board must say so (SPEC 2).
    with st.time("board"):
        board = json.loads(sh(["python3", BOARD, "--json"], timeout=120,
                              strict=True) or "[]")
    with st.time("run"):
        run_id = current_run()
    with st.time("gates"):
        gates = orca_json("orchestration", "gate-list", "--run", run_id).get("gates", [])
        for g in gates:
            try:
                g["options"] = json.loads(g.get("options") or "[]")
            except Exception:
                g["options"] = []
        runs = sh([ORCA, "orchestration", "run-list"], strict=True).splitlines()
    pending = [g for g in gates if g.get("status") == "pending"]
    resolved = [g for g in gates if g.get("status") != "pending"]
    with st.time("watcher"):
        w_alive, w_ts = watcher()
    with st.time("git_scan"):
        gits = git_scan([p.get("cwd") for p in board])
        gitmap = {g["cwd"]: g for g in gits}
    claims = claims_update(board)
    stuck, stuck_candidates, stuck_observed = stuck_lanes(board, gitmap, claims)
    # Attach the work each pane has actually done. Both numbers are already
    # computed for the stuck surface and the estate sweep; the wall was the
    # one place showing pane text without them, so a lane that had committed
    # nothing for a day looked identical to one that had just landed.
    _now = time.time()
    for p in board:
        g = gitmap.get(p.get("cwd") or "")
        p["last_ts"] = g["ts"] if g else None
        p["last_sha"] = g["sha"] if g else ""
        p["last_text"] = g["text"] if g else ""
        c = claims.get(p.get("handle")) or {}
        p["held"] = int(_now - c["since"]) if c.get("since") else None
        p["held_assumed"] = bool(c.get("assumed"))
    with st.time("orphans"):
        orphans, orphan_total = inflight_orphans(board)
    with st.time("estate"):
        estate = estate_sweep([p.get("cwd") for p in board])
    with st.time("drafts"):
        dage = drafts_age()
    with st.time("grill"):
        grill = grill_state()
    with st.time("tasks"):
        tasks_now = load_tasks(run_id)
    # The strip needs the counts on every poll; the fold needs the rows only
    # when it opens. Counting here keeps the lean payload two small numbers.
    counts = {}
    for t in tasks_now:
        k = t.get("status") or "?"
        counts[k] = counts.get(k, 0) + 1
    trend = trend_record(trend_values(board, tasks_now, estate, dage, grill))
    with st.time("daily"):
        daily = daily_events()
    with LOCK:
        CACHE.update(ts=time.time(), panes=board, tasks=tasks_now,
                     task_counts=counts, resolved_count=len(resolved),
                     gates=pending, resolved=resolved[-8:],
                     drafts=queue_read(), lanes=load_lanes(),
                     log=tail_log(), watcher_alive=w_alive, watcher_ts=w_ts,
                     timings=st.t, refresh_secs=round(sum(st.t.values()), 1),
                     problems=[dict(where=k, why=v["why"], ts=v["ts"])
                               for k, v in sorted(PROBLEMS.items())],
                     daily=daily, gitlog=gits[:12], stuck=stuck,
                     stuck_candidates=stuck_candidates, stuck_observed=stuck_observed,
                     orphans=orphans, orphan_total=orphan_total, estate=estate,
                     drafts_age=dage, grill=grill, trend=trend, acks=acks_read(),
                     ack_stale_s=ACK_STALE_S,
                     run=runs[0][:120] if runs else "")


REFRESH_GATE = threading.Lock()
REFRESH_STATE = {"busy": False, "again": False}


def refresh_coalesced():
    """One scrape at a time, and a request during one schedules exactly one more.

    A full refresh takes about a minute for fifteen panes - orca-board costs
    roughly a second per pane - while the loop ticks every twenty seconds
    and every tap starts another. So overlapping scrapes were not a risk,
    they were the normal case: two or three copies of the same work running
    at once, each spawning a subprocess per pane, each doing a
    read-modify-write on the claims and trend files with no lock between
    them.

    Coalescing rather than queueing, because a queue of N identical scrapes
    is N times the work for one answer. A tap still gets its effect shown:
    if a scrape is already running, `again` is set and one more runs as soon
    as it finishes, so the tap's change lands on the next pass instead of
    being dropped.

    The error state is owned here rather than by the caller, so a coalesced
    call cannot clear an error it did not disprove.
    """
    with REFRESH_GATE:
        if REFRESH_STATE["busy"]:
            REFRESH_STATE["again"] = True
            return False
        REFRESH_STATE["busy"] = True
    try:
        while True:
            try:
                refresh()
                with LOCK:
                    CACHE["err"] = ""
            except Exception as e:
                with LOCK:
                    CACHE["err"] = "%s: %s" % (type(e).__name__, e)
                    CACHE["err_ts"] = time.time()
            with REFRESH_GATE:
                if not REFRESH_STATE["again"]:
                    return True
                REFRESH_STATE["again"] = False
    finally:
        with REFRESH_GATE:
            REFRESH_STATE["busy"] = False


def refresher():
    """A dead refresher must not render as a healthy board.

    The old version swallowed every exception, so an hour-old cache looked
    normal. The failure rides along in the payload now and the header says
    so (SPEC 2). refresh_coalesced owns that bookkeeping.
    """
    while True:
        refresh_coalesced()
        time.sleep(20)


