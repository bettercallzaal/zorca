def load_tasks(run_id):
    """Straight from the orchestration DB, read-only - specs included.

    file: URI with mode=ro so we can never write, and a busy_timeout so a
    daemon write never wedges the refresh.
    """
    import sqlite3
    rows = []
    try:
        con = sqlite3.connect("file:%s?mode=ro" % ODB, uri=True, timeout=3)
        cur = con.execute(
            "SELECT id, status, task_title, spec, created_at FROM tasks "
            "ORDER BY created_at")
        for tid, status, title, spec, upd in cur.fetchall():
            rows.append(dict(id=tid, status=status, title=title or "?",
                             spec=spec or "", updated=upd or ""))
        con.close()
    except Exception:
        # Fall back to the CLI text parse if the schema shifts.
        for ln in sh([ORCA, "orchestration", "task-list", "--run",
                      run_id]).splitlines():
            ln = ln.strip()
            if ln.startswith("task_"):
                parts = ln.split()
                rows.append(dict(id=parts[0],
                                 status=parts[1].strip("[]") if len(parts) > 1 else "?",
                                 title=parts[2] if len(parts) > 2 else "?",
                                 spec="", updated=""))
    return rows


