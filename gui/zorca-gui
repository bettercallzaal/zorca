#!/usr/bin/env python3
"""
zorca-gui - the ZAO orchestration dashboard, local only.

One file, stdlib only. Serves a live board at http://127.0.0.1:7777 over
YOUR state: Orca panes (via orca-board --json), the orchestration Run's
tasks and decision gates (via the orca CLI). Gates are answered by tapping
an option - the tap runs `orca orchestration gate-resolve`, nothing else.

Never exposed off-localhost. Never touches Orca's code. Reads state, and
the only writes it can do are the ones Zaal taps: resolve a gate, focus a
pane.

Run:  zorca-gui            (then open http://127.0.0.1:7777)
      zorca-gui --port N
"""
import json
import os
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ORCA = "/opt/homebrew/bin/orca"
BOARD = os.path.expanduser("~/bin/orca-board")
PORT = 7777

# State cache: pane scraping costs ~1s per pane, so refresh in the
# background and serve the cache instantly.
CACHE = {"ts": 0, "panes": [], "tasks": [], "gates": [], "run": "",
         "drafts": [], "resolved": [], "lanes": []}
LOCK = threading.Lock()
QUEUE = os.path.expanduser("~/.zao/orca-drafts.json")


def queue_read():
    try:
        return json.load(open(QUEUE))
    except Exception:
        return []


def queue_drop(did):
    items = [i for i in queue_read() if i.get("id") != did]
    json.dump(items, open(QUEUE, "w"), indent=1)


def sh(args, timeout=60):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


def orca_json(*args):
    out = sh([ORCA] + list(args) + ["--json"])
    try:
        return json.loads(out).get("result", {})
    except Exception:
        return {}


def load_tasks(run_id):
    """task-list has no --json list shape everywhere; parse the text."""
    rows = []
    for ln in sh([ORCA, "orchestration", "task-list", "--run", run_id]).splitlines():
        ln = ln.strip()
        if not ln.startswith("task_"):
            continue
        parts = ln.split()
        tid = parts[0]
        status = parts[1].strip("[]") if len(parts) > 1 else "?"
        title = parts[2] if len(parts) > 2 else "?"
        rows.append(dict(id=tid, status=status, title=title))
    return rows


MANIFEST = os.path.expanduser(
    "~/zao-vault/handoffs/orca-resume-manifest-2026-08-25.md")


def load_lanes():
    """Parked lanes from the vault manifest: | Lane | `worktree` | `cmd` |"""
    lanes = []
    try:
        for ln in open(MANIFEST):
            if not ln.startswith("|") or "---" in ln or "Worktree" in ln:
                continue
            cells = [c.strip() for c in ln.strip("|\n").split("|")]
            if len(cells) < 3:
                continue
            name = cells[0]
            wt = cells[1].strip("`").replace("~", os.path.expanduser("~"))
            m = cells[2]
            cmd = ""
            if "claude --resume" in m:
                cmd = "claude --resume " + \
                    m.split("claude --resume", 1)[1].strip("` ").split("`")[0].split(" - ")[0].strip()
            if cmd and os.path.isdir(wt):
                lanes.append(dict(name=name, worktree=wt, cmd=cmd))
    except Exception:
        pass
    return lanes


def current_run():
    """Terminal bindings die on every Orca restart; discover, never bind."""
    for ln in sh([ORCA, "orchestration", "run-list"]).splitlines():
        if ln.startswith("run_") and "legacy" not in ln:
            return ln.split()[0]
    return ""


def refresh():
    board = []
    try:
        board = json.loads(sh(["python3", BOARD, "--json"], timeout=120))
    except Exception:
        pass
    run_id = current_run()
    gates = orca_json("orchestration", "gate-list", "--run", run_id).get("gates", [])
    for g in gates:
        try:
            g["options"] = json.loads(g.get("options") or "[]")
        except Exception:
            g["options"] = []
    runs = sh([ORCA, "orchestration", "run-list"]).splitlines()
    pending = [g for g in gates if g.get("status") == "pending"]
    resolved = [g for g in gates if g.get("status") != "pending"]
    with LOCK:
        CACHE.update(ts=time.time(), panes=board, tasks=load_tasks(run_id),
                     gates=pending, resolved=resolved[-8:],
                     drafts=queue_read(), lanes=load_lanes(),
                     run=runs[0][:120] if runs else "")


def refresher():
    while True:
        try:
            refresh()
        except Exception:
            pass
        time.sleep(20)


