# Only these may appear as the Host or the Origin's hostname. Everything
# else is a cross-origin page in Zaal's browser or a DNS rebind pointing a
# hostile name at 127.0.0.1.
LOCAL_HOSTS = {"127.0.0.1", "localhost", "::1", "[::1]"}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def local_only(self):
        """Refuse the request itself, not just its response: CORS stops a
        cross-origin page READING the reply, not SENDING the POST, and every
        POST here acts on something. Host catches a DNS rebind; Origin
        catches a cross-site page (absent for curl and local scripts, which
        is allowed - a browser page cannot omit it); Sec-Fetch-Site is the
        belt to those braces."""
        host = (self.headers.get("Host") or "").strip()
        if host.startswith("["):
            host = host.split("]")[0] + "]"
        else:
            host = host.rsplit(":", 1)[0] if ":" in host else host
        if host not in LOCAL_HOSTS:
            return False, "Host %r is not local" % host[:60]
        origin = (self.headers.get("Origin") or "").strip()
        if origin and origin.lower() != "null":
            try:
                hostname = urllib.parse.urlparse(origin).hostname or ""
            except Exception:
                hostname = ""
            if hostname not in LOCAL_HOSTS:
                return False, "Origin %r is cross-site" % origin[:60]
        elif origin.lower() == "null":
            return False, "Origin null"
        site = (self.headers.get("Sec-Fetch-Site") or "").strip().lower()
        if site and site not in ("same-origin", "same-site", "none"):
            return False, "Sec-Fetch-Site %r" % site[:40]
        return True, ""

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif self.path == "/api/state":
            with LOCK:
                self._send(200, json.dumps(CACHE))
        else:
            self._send(404, "{}")

    def do_POST(self):
        ok, why = self.local_only()
        if not ok:
            self._send(403, json.dumps({"ok": False, "why": why}))
            return
        n = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(n) or "{}")
        except Exception:
            body = {}
        if self.path == "/api/resolve" and body.get("id") and body.get("resolution"):
            if not is_token(body["id"]):
                self._send(400, json.dumps({"ok": False, "why": "bad gate id"}))
                return
            out = sh([ORCA, "orchestration", "gate-resolve", flag("id", body["id"]),
                      flag("resolution", body["resolution"]), "--json"])
            ok = '"ok": true' in out or '"ok":true' in out
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/focus" and body.get("handle"):
            if not is_token(body["handle"]):
                self._send(400, json.dumps({"ok": False, "why": "bad handle"}))
                return
            sh([ORCA, "terminal", "switch", flag("terminal", body["handle"])])
            self._send(200, '{"ok": true}')
        elif self.path == "/api/lane" and body.get("i") is not None:
            lanes = load_lanes()
            ok = False
            try:
                l = lanes[int(body["i"])]
                # Zaal's tap: open an Orca pane in the lane's worktree and
                # resume its Claude session. Spawns a paid session - which is
                # exactly what the button says it does.
                if l.get("bad") or not l.get("cmd"):
                    self._send(400, json.dumps(
                        {"ok": False, "why": l.get("bad") or "no command"}))
                    return
                out = sh([ORCA, "terminal", "create",
                          flag("worktree", "path:" + l["worktree"]),
                          flag("title", l["name"]),
                          flag("command", l["cmd"]), "--focus"], timeout=120)
                ok = "Created terminal" in out
            except Exception:
                pass
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        elif self.path == "/api/draft" and body.get("id"):
            item = next((i for i in queue_read() if i["id"] == body["id"]), None)
            ok = True
            if item and body.get("action") == "send":
                # The human tapped Send - this is Zaal's keystroke, so no
                # auto-draft prefix; it carries his authority.
                if not is_token(item.get("handle")):
                    self._send(400, json.dumps(
                        {"ok": False, "why": "bad handle in the queue"}))
                    return
                out = sh([ORCA, "terminal", "send", flag("terminal", item["handle"]),
                          flag("text", item["text"]), "--enter"])
                ok = "Sent" in out
            if item:
                queue_drop(body["id"])
            threading.Thread(target=refresh, daemon=True).start()
            self._send(200 if ok else 500, json.dumps({"ok": ok}))
        else:
            self._send(400, '{"ok": false}')


def main():
    port = PORT
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    threading.Thread(target=refresher, daemon=True).start()
    print("ZORCA GUI on http://127.0.0.1:%d  (ctrl-c to stop)" % port)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


if __name__ == "__main__":
    main()
