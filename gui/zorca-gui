#!/usr/bin/env python3
"""
zorca-gui - the ZAO orchestration dashboard, local only.

One file, stdlib only. Serves a live board at http://127.0.0.1:7777 over
YOUR state: Orca panes (via orca-board --json), the orchestration Run's
tasks and decision gates (via the orca CLI). Gates are answered by tapping
an option - the tap runs `orca orchestration gate-resolve`, nothing else.

Never exposed off-localhost. Never touches Orca's code. Reads state, and
the only writes it can do are the ones Zaal taps: resolve a gate, focus a
pane.

Run:  zorca-gui            (then open http://127.0.0.1:7777)
      zorca-gui --port N
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ORCA = "/opt/homebrew/bin/orca"
BOARD = os.path.expanduser("~/bin/orca-board")
PORT = 7777

# State cache: pane scraping costs ~1s per pane, so refresh in the
# background and serve the cache instantly.
CACHE = {"ts": 0, "panes": [], "tasks": [], "gates": [], "run": "",
         "drafts": [], "resolved": [], "lanes": [], "log": []}
LOCK = threading.Lock()
QUEUE = os.path.expanduser("~/.zao/orca-drafts.json")


def queue_read():
    try:
        return json.load(open(QUEUE))
    except Exception:
        return []


def queue_drop(did):
    items = [i for i in queue_read() if i.get("id") != did]
    json.dump(items, open(QUEUE, "w"), indent=1)


def sh(args, timeout=60):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


# A value that starts with a dash is parsed as a FLAG in the space form:
# `--resolution "--json"` makes orca answer "Missing required --resolution".
# The `=` form binds the value to its own flag. Every user-supplied value
# goes through this. (Same fix as gui/zorca-gui2, verified against the CLI.)
def flag(name, value):
    return "--%s=%s" % (name, value)


# Handles, gate ids and draft ids are opaque tokens, not free text. Anything
# outside this set cannot be a real id, so it is refused rather than passed on.
TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")


def is_token(v):
    return bool(v) and isinstance(v, str) and bool(TOKEN_RE.match(v))


def orca_json(*args):
    out = sh([ORCA] + list(args) + ["--json"])
    try:
        return json.loads(out).get("result", {})
    except Exception:
        return {}


ODB = os.path.expanduser(
    "~/Library/Application Support/orca/orchestration.db")


def load_tasks(run_id):
    """Straight from the orchestration DB, read-only - specs included.

    file: URI with mode=ro so we can never write, and a busy_timeout so a
    daemon write never wedges the refresh.
    """
    import sqlite3
    rows = []
    try:
        con = sqlite3.connect("file:%s?mode=ro" % ODB, uri=True, timeout=3)
        cur = con.execute(
            "SELECT id, status, task_title, spec, created_at FROM tasks "
            "ORDER BY created_at")
        for tid, status, title, spec, upd in cur.fetchall():
            rows.append(dict(id=tid, status=status, title=title or "?",
                             spec=spec or "", updated=upd or ""))
        con.close()
    except Exception:
        # Fall back to the CLI text parse if the schema shifts.
        for ln in sh([ORCA, "orchestration", "task-list", "--run",
                      run_id]).splitlines():
            ln = ln.strip()
            if ln.startswith("task_"):
                parts = ln.split()
                rows.append(dict(id=parts[0],
                                 status=parts[1].strip("[]") if len(parts) > 1 else "?",
                                 title=parts[2] if len(parts) > 2 else "?",
                                 spec="", updated=""))
    return rows


MANIFEST = os.path.expanduser(
    "~/zao-vault/handoffs/orca-resume-manifest-2026-08-25.md")


# A resume target is a UUID or a session NAME (the manifest writes names
# quoted: `claude --resume "zaostock"`). Both are plain tokens; anything
# carrying a shell metacharacter is refused, not sanitised.
SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$")


def load_lanes():
    """Parked lanes from the vault manifest: | Lane | `worktree` | `cmd` |

    The manifest is a file every lane can append to, and the command is
    handed to `orca terminal create --command`, which runs it in a shell.
    So the session id is EXTRACTED and validated, and the command is built
    here from a literal - nothing from the file reaches a shell. A refused
    row keeps its reason in `bad` so the board can say why there is no
    button.
    """
    lanes = []
    try:
        for ln in open(MANIFEST):
            if not ln.startswith("|") or "---" in ln or "Worktree" in ln:
                continue
            cells = [c.strip() for c in ln.strip("|\n").split("|")]
            if len(cells) < 3:
                continue
            name = cells[0]
            wt = cells[1].strip("`").replace("~", os.path.expanduser("~"))
            m = cells[2]
            cmd, bad = "", ""
            if "claude --resume" not in m:
                bad = "no `claude --resume` in the row"
            else:
                rest = m.split("claude --resume", 1)[1].strip("` ")
                rest = rest.split("`")[0].split(" - ")[0].strip()
                rest = rest.strip('"').strip("'").strip()
                parts = rest.split()
                if len(parts) > 1:
                    bad = "row carries more than a session id: %r" % rest[:48]
                elif not SESSION_RE.match(parts[0] if parts else ""):
                    bad = "session id is not a plain token: %r" % (rest or "")[:40]
                else:
                    cmd = "claude --resume " + parts[0]
            if not os.path.isdir(wt):
                continue
            if name.startswith("-") or wt.startswith("-"):
                bad = bad or "name or worktree starts with a dash"
            lanes.append(dict(name=name, worktree=wt, cmd=cmd, bad=bad))
    except Exception:
        pass
    return lanes


BOARD_LOG = os.path.expanduser("~/.zao/orca-board.log")


def tail_log(n=14):
    """Last lines of the watcher log - the HOLD/QUEUE/SENT trail."""
    try:
        with open(BOARD_LOG, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 8192))
            lines = f.read().decode(errors="replace").splitlines()
        return [l for l in lines if l.strip()][-n:]
    except Exception:
        return []


def current_run():
    """Terminal bindings die on every Orca restart; discover, never bind."""
    for ln in sh([ORCA, "orchestration", "run-list"]).splitlines():
        if ln.startswith("run_") and "legacy" not in ln:
            return ln.split()[0]
    return ""


def refresh():
    board = []
    try:
        board = json.loads(sh(["python3", BOARD, "--json"], timeout=120))
    except Exception:
        pass
    run_id = current_run()
    gates = orca_json("orchestration", "gate-list", "--run", run_id).get("gates", [])
    for g in gates:
        try:
            g["options"] = json.loads(g.get("options") or "[]")
        except Exception:
            g["options"] = []
    runs = sh([ORCA, "orchestration", "run-list"]).splitlines()
    pending = [g for g in gates if g.get("status") == "pending"]
    resolved = [g for g in gates if g.get("status") != "pending"]
    with LOCK:
        CACHE.update(ts=time.time(), panes=board, tasks=load_tasks(run_id),
                     gates=pending, resolved=resolved[-8:],
                     drafts=queue_read(), lanes=load_lanes(),
                     log=tail_log(),
                     run=runs[0][:120] if runs else "")


def refresher():
    while True:
        try:
            refresh()
        except Exception:
            pass
        time.sleep(20)


